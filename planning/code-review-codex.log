import { describe, expect, it } from "vitest";
import { emptySave, mergeSaves, parseSave, recordRound, SAVE_VERSION } from "../progress";

describe("progress", () => {
  it("treats missing storage as a fresh save", () => {
    expect(parseSave(null)).toEqual({ ok: true, save: emptySave() });
  });
  it("survives corrupt JSON", () => {
    const r = parseSave("{not json");
    expect(r.ok).toBe(false);
    expect(r.save.rounds).toEqual({});
  });
  it("refuses a newer save version instead of overwriting it", () => {
    const r = parseSave(JSON.stringify({ version: SAVE_VERSION + 1, rounds: {} }));
    expect(r).toMatchObject({ ok: false, reason: "newer" });
  });
  it("drops malformed round records but keeps good ones", () => {
    const r = parseSave(JSON.stringify({ version: 1, rounds: { a: { marks: 2, max: 3 }, b: "x" } }));
    expect(Object.keys(r.save.rounds)).toEqual(["a"]);
  });
  it("keeps the best result and is idempotent", () => {
    let s = recordRound(emptySave(), "r1", { marks: 3, max: 3, firstTry: false });
    s = recordRound(s, "r1", { marks: 1, max: 3, firstTry: false });
    s = recordRound(s, "r1", { marks: 1, max: 3, firstTry: false });
    expect(s.rounds.r1).toEqual({ marks: 3, max: 3, firstTry: false });
  });
  it("merges two tabs without losing completion", () => {
    const a = recordRound(emptySave(), "x", { marks: 3, max: 3, firstTry: true }, ["Slab!"]);
    const b = recordRound(emptySave(), "y", { marks: 2, max: 3, firstTry: false }, ["Slab!", "beam"]);
    const m = mergeSaves(a, b);
    expect(Object.keys(m.rounds).sort()).toEqual(["x", "y"]);
    expect(m.phrases).toEqual(["Slab!", "beam"]);
  });
});
"use client";

import { useCallback, useEffect, useSyncExternalStore } from "react";
import { emptySave, loadSave, writeSave, type Save, SAVE_KEY } from "./progress";

type State = { save: Save; storable: boolean; ready: boolean };

let state: State = { save: emptySave(), storable: true, ready: false };
const listeners = new Set<() => void>();

function emit() {
  for (const l of listeners) l();
}

function init() {
  if (state.ready || typeof window === "undefined") return;
  const r = loadSave();
  state = { save: r.save, storable: r.ok, ready: true };
  window.addEventListener("storage", (e) => {
    if (e.key !== SAVE_KEY) return;
    const next = loadSave();
    state = { ...state, save: next.save };
    emit();
  });
}

const SERVER: State = { save: emptySave(), storable: true, ready: false };

/** The player's local progress, shared by every component on the page. */
export function useSave() {
  const snap = useSyncExternalStore(
    (l) => {
      listeners.add(l);
      return () => listeners.delete(l);
    },
    () => state,
    () => SERVER,
  );
  useEffect(() => {
    if (!state.ready) {
      init();
      emit();
    }
  }, []);

  const update = useCallback((fn: (s: Save) => Save) => {
    const next = fn(state.save);
    const ok = writeSave(next);
    state = { save: next, storable: ok, ready: true };
    emit();
  }, []);

  return { ...snap, update };
}

/** Speak a line in English when the browser can; the text is always on screen too. */
export function useSpeech(enabled: boolean) {
  const available = useSyncExternalStore(
    () => () => {},
    () => "speechSynthesis" in window,
    () => false,
  );
  const speak = useCallback(
    (text: string) => {
      if (!enabled || !available) return;
      const synth = window.speechSynthesis;
      synth.cancel();
      const u = new SpeechSynthesisUtterance(text.replace(/—/g, ","));
      const voice = synth.getVoices().find((v) => v.lang === "en-GB") ?? synth.getVoices().find((v) => v.lang.startsWith("en"));
      if (voice) u.voice = voice;
      u.lang = voice?.lang ?? "en-GB";
      u.rate = 0.9;
      synth.speak(u);
    },
    [enabled, available],
  );
  return { speak, available };
}
"use client";

import { useEffect, useState } from "react";

const PREFIX = "language-games:draft:";

/**
 * Round state that survives a reload: half-built calls, placed objects, cards
 * shown. Keyed by round id; cleared when the player moves on.
 */
export function useDraft<T>(round: string, field: string, initial: T | (() => T)) {
  const key = `${PREFIX}${round}:${field}`;
  const [value, setValue] = useState<T>(() => {
    try {
      const raw = window.localStorage.getItem(key);
      if (raw !== null) return JSON.parse(raw) as T;
    } catch {
      // Unreadable draft: start the round fresh.
    }
    return typeof initial === "function" ? (initial as () => T)() : initial;
  });
  useEffect(() => {
    try {
      window.localStorage.setItem(key, JSON.stringify(value));
    } catch {
      // Storage full or blocked: the round still works in memory.
    }
  }, [key, value]);
  return [value, setValue] as const;
}

export function clearDrafts(round?: string) {
  try {
    const store = window.localStorage;
    const prefix = round ? `${PREFIX}${round}:` : PREFIX;
    for (let i = store.length - 1; i >= 0; i--) {
      const k = store.key(i);
      if (k?.startsWith(prefix)) store.removeItem(k);
    }
  } catch {
    // Nothing to clear.
  }
}

