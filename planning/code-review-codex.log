   1 "use client";
   2 
   3 import { useCallback, useEffect, useSyncExternalStore } from "react";
   4 import { emptySave, loadSave, writeSave, type Save, SAVE_KEY } from "./progress";
   5 
   6 type State = { save: Save; storable: boolean; ready: boolean };
   7 
   8 let state: State = { save: emptySave(), storable: true, ready: false };
   9 const listeners = new Set<() => void>();
  10 
  11 function emit() {
  12   for (const l of listeners) l();
  13 }
  14 
  15 function init() {
  16   if (state.ready || typeof window === "undefined") return;
  17   const r = loadSave();
  18   state = { save: r.save, storable: r.ok, ready: true };
  19   window.addEventListener("storage", (e) => {
  20     if (e.key !== SAVE_KEY) return;
  21     const next = loadSave();
  22     state = { ...state, save: next.save };
  23     emit();
  24   });
  25 }
  26 
  27 const SERVER: State = { save: emptySave(), storable: true, ready: false };
  28 
  29 /** The player's local progress, shared by every component on the page. */
  30 export function useSave() {
  31   const snap = useSyncExternalStore(
  32     (l) => {
  33       listeners.add(l);
  34       return () => listeners.delete(l);
  35     },
  36     () => state,
  37     () => SERVER,
  38   );
  39   useEffect(() => {
  40     if (!state.ready) {
  41       init();
  42       emit();
  43     }
  44   }, []);
  45 
  46   const update = useCallback((fn: (s: Save) => Save) => {
  47     const next = fn(state.save);
  48     const ok = writeSave(next);
  49     state = { save: next, storable: ok, ready: true };
  50     emit();
  51   }, []);
  52 
  53   return { ...snap, update };
  54 }
  55 
  56 /** Speak a line in English when the browser can; the text is always on screen too. */
  57 export function useSpeech(enabled: boolean) {
  58   const available = useSyncExternalStore(
  59     () => () => {},
  60     () => "speechSynthesis" in window,
  61     () => false,
  62   );
  63   const speak = useCallback(
  64     (text: string) => {
  65       if (!enabled || !available) return;
  66       const synth = window.speechSynthesis;
  67       synth.cancel();
  68       const u = new SpeechSynthesisUtterance(text.replace(/—/g, ","));
  69       const voice = synth.getVoices().find((v) => v.lang === "en-GB") ?? synth.getVoices().find((v) => v.lang.startsWith("en"));
  70       if (voice) u.voice = voice;
  71       u.lang = voice?.lang ?? "en-GB";
  72       u.rate = 0.9;
  73       synth.speak(u);
  74     },
  75     [enabled, available],
  76   );
  77   return { speak, available };
  78 }
