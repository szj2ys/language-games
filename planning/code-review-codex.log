 105 /** Merge two saves (e.g. another tab wrote meanwhile) without losing completion. */
 106 export function mergeSaves(a: Save, b: Save): Save {
 107   let out: Save = {
 108     ...a,
 109     settings: b.settings,
 110     lastGame: b.lastGame ?? a.lastGame,
 111     positions: { ...a.positions, ...b.positions },
 112   };
 113   for (const [id, r] of Object.entries(b.rounds)) out = recordRound(out, id, r);
 114   const seen = new Set(out.phrases);
 115   out.phrases = [...out.phrases, ...b.phrases.filter((p) => !seen.has(p))].slice(-200);
 116   return out;
 117 }
