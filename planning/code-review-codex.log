   3 import { useEffect, useState } from "react";
   4 
   5 const PREFIX = "language-games:draft:";
   6 
   7 /**
   8  * Round state that survives a reload: half-built calls, placed objects, cards
   9  * shown. Keyed by round id; cleared when the player moves on.
  10  */
  11 export function useDraft<T>(round: string, field: string, initial: T | (() => T)) {
  12   const key = `${PREFIX}${round}:${field}`;
  13   const [value, setValue] = useState<T>(() => {
  14     try {
  15       const raw = window.localStorage.getItem(key);
  16       if (raw !== null) return JSON.parse(raw) as T;
  17     } catch {
  18       // Unreadable draft: start the round fresh.
  19     }
  20     return typeof initial === "function" ? (initial as () => T)() : initial;
  21   });
  22   useEffect(() => {
  23     try {
  24       window.localStorage.setItem(key, JSON.stringify(value));
  25     } catch {
  26       // Storage full or blocked: the round still works in memory.
  27     }
  28   }, [key, value]);
  29   return [value, setValue] as const;
  30 }
  31 
  32 export function clearDrafts(round?: string) {
  33   try {
  34     const store = window.localStorage;
  35     const prefix = round ? `${PREFIX}${round}:` : PREFIX;
  36     for (let i = store.length - 1; i >= 0; i--) {
  37       const k = store.key(i);
  38       if (k?.startsWith(prefix)) store.removeItem(k);
  39     }
  40   } catch {
  41     // Nothing to clear.
  42   }

