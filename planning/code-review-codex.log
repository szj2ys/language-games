"use client";

import Link from "next/link";
import { useState } from "react";
import { Button } from "@/components/ui/button";
import { GAMES } from "@/content/games";
import { NOTEBOOK } from "@/content/notebook";
import { clearSave, emptySave } from "@/lib/progress";
import { useSave } from "@/lib/use-save";

export function Notebook() {
  const { save, ready, update } = useSave();
  const [confirm, setConfirm] = useState(false);
  if (!ready) return null;
  const played = GAMES.filter((g) => g.rounds.some((id) => save.rounds[id]));

  const replay = (slug: string, session: number) =>
    update((s) => ({ ...s, lastGame: slug, positions: { ...s.positions, [slug]: { session, round: 0 } } }));

  if (played.length === 0)
    return (
      <div className="mt-4 flex flex-col items-start gap-4">
        <p className="text-[17px]">Nothing here yet. Play a round and the English you use will be kept here, game by game.</p>
        <Link href="/play/builder" className="inline-flex h-12 items-center rounded-lg bg-cobalt px-5 text-[17px] font-bold text-paper">
          Start with Slab!
        </Link>
      </div>
    );

  return (
    <div className="mt-4 flex flex-col gap-8">
      {played.map((g) => (
        <section key={g.slug} aria-labelledby={`nb-${g.slug}`}>
          <h2 id={`nb-${g.slug}`} className="font-heading text-2xl font-semibold">
            {g.title}
          </h2>
          {NOTEBOOK[g.slug]
            .filter((s) => s.rounds.some((r) => save.rounds[r.id]))
            .map((s) => (
              <div key={s.title} className="mt-3">
                <div className="flex items-baseline justify-between gap-3">
                  <h3 className="font-bold">{s.title}</h3>
                  <Link
                    href={`/play/${g.slug}`}
                    onClick={() => replay(g.slug, s.index)}
                    className="inline-flex min-h-11 items-center text-sm font-bold text-cobalt underline-offset-4 hover:underline"
                  >
                    Play again
                  </Link>
                </div>
                <ul className="mt-1 flex flex-col gap-1.5">
                  {s.rounds
                    .filter((r) => save.rounds[r.id])
                    .map((r) => {
                      const rec = save.rounds[r.id];
                      return (
                        <li key={r.id} className="rounded-lg bg-card px-3 py-2">
                          {(rec.said ?? []).slice(0, 3).map((line) => (
                            <p key={line} className="font-heading text-[17px] leading-snug">
                              {line}
                            </p>
                          ))}
                          <p className="text-sm text-muted-foreground">
                            {r.did.charAt(0).toUpperCase() + r.did.slice(1)}
                            {rec.firstTry ? " · first try" : ""}
                          </p>
                        </li>
                      );
                    })}
                </ul>
              </div>
            ))}
        </section>
      ))}
      <section>
        {confirm ? (
          <div className="flex flex-wrap items-center gap-2">
            <span className="text-[15px]">Delete all progress in this browser?</span>
            <Button
              variant="destructive"
              className="h-11"
              onClick={() => {
                clearSave();
                update(() => emptySave());
                setConfirm(false);
              }}
            >
              Yes, start over
            </Button>
            <Button variant="outline" className="h-11" onClick={() => setConfirm(false)}>
              Keep it
            </Button>
          </div>
        ) : (
          <Button variant="outline" className="h-11" onClick={() => setConfirm(true)}>
            Reset progress
          </Button>
        )}
      </section>
    </div>
  );
}
"use client";

import Link from "next/link";
import { ArrowRight } from "lucide-react";
import { buttonVariants } from "@/components/ui/button";
import { GAMES } from "@/content/games";
import { SOURCES } from "@/content/sources";
import { useSave } from "@/lib/use-save";
import { cn } from "@/lib/utils";

/** Continue where you left off; first visit starts with Slab!. */
export function ContinueButton() {
  const { save, ready } = useSave();
  const last = ready ? GAMES.find((g) => g.slug === save.lastGame) : undefined;
  const target = last ?? GAMES[0];
  return (
    <Link href={`/play/${target.slug}`} className={cn(buttonVariants({ size: "lg" }), "h-13 px-6 text-lg")}>
      {last ? `Continue ${last.title}` : `Play ${target.title}`} <ArrowRight className="size-5" aria-hidden />
    </Link>
  );
}

export function GameProgress({ rounds }: { rounds: string[] }) {
  const { save, ready } = useSave();
  if (!ready) return null;
  const done = rounds.filter((id) => save.rounds[id]).length;
  if (done === 0) return null;
  return (
    <span className="shrink-0 rounded-full bg-sage/15 px-2 py-0.5 text-sm font-bold text-sage">
      {done === rounds.length ? "Done" : `${done}/${rounds.length}`}
    </span>
  );
}

/** When every round is done: no streak, no "come back tomorrow" — the ladder can be thrown away. */
export function LadderEnd() {
  const { save, ready } = useSave();
  if (!ready) return null;
  const all = GAMES.flatMap((g) => g.rounds);
  if (!all.every((id) => save.rounds[id])) return null;
  const ladder = SOURCES["tlp-6.54"];
  const stop = SOURCES["pi-133"];
  return (
    <section className="mt-8 rounded-2xl border border-border bg-card p-5" aria-labelledby="ladder">
      <h2 id="ladder" className="font-heading text-2xl font-semibold">
        You have played every game.
      </h2>
      <p className="mt-2 text-[17px] leading-relaxed">
        That is the end — there is no streak to keep. In the Tractatus Wittgenstein says of his own book: “{ladder.quote}”
        ({ladder.ref}). Later he put it differently: “{stop.quote}” (PI {stop.ref}). Take the English and go and use it.
      </p>
    </section>
  );
}

