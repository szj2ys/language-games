  11 export function useDraft<T>(round: string, field: string, initial: T | (() => T)) {
  12   const key = `${PREFIX}${round}:${field}`;
  13   const [value, setValue] = useState<T>(() => {
  14     try {
  15       const raw = window.localStorage.getItem(key);
  16       if (raw !== null) return JSON.parse(raw) as T;
  17     } catch {
  18       // Unreadable draft: start the round fresh.
  19     }
  20     return typeof initial === "function" ? (initial as () => T)() : initial;
  21   });
  22   useEffect(() => {
  23     try {
  24       window.localStorage.setItem(key, JSON.stringify(value));
  25     } catch {
  26       // Storage full or blocked: the round still works in memory.
  27     }
  28   }, [key, value]);
  29   return [value, setValue] as const;
  30 }
