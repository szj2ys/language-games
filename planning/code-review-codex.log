   1 "use client";
   2 
   3 import { track } from "@/components/analytics";
   4 import { recordRound } from "@/lib/progress";
   5 import { useSave, useSpeech } from "@/lib/use-save";
   6 import { clearDrafts } from "@/lib/use-draft";
   7 
   8 type SessionLike = { rounds: { id: string }[] };
   9 
  10 /** Where the player is in a game's sessions, saved locally so a reload resumes the same round. */
  11 export function useSessions<S extends SessionLike>(game: string, sessions: S[]) {
  12   const { save, ready, update, storable } = useSave();
  13   const pos = save.positions[game] ?? { session: 0, round: 0 };
  14   const sessionIndex = Math.min(pos.session, sessions.length - 1);
  15   const session = sessions[sessionIndex];
  16   const finished = pos.round >= session.rounds.length;
  17   const roundIndex = Math.min(pos.round, session.rounds.length - 1);
  18   const round = session.rounds[roundIndex] as S["rounds"][number];
  19   const speech = useSpeech(save.settings.speech);
  20 
  21   const goTo = (s: number, r: number) => {
  22     for (const x of session.rounds) clearDrafts(x.id);
  23     return update((sv) => ({ ...sv, lastGame: game, positions: { ...sv.positions, [game]: { session: s, round: r } } }));
  24   };
  25 
  26   return {
  27     save,
  28     ready,
  29     storable,
  30     session,
  31     sessionIndex,
  32     round,
  33     roundIndex,
  34     finished,
  35     speech,
  36     toggleSpeech: () => update((s) => ({ ...s, settings: { ...s.settings, speech: !s.settings.speech } })),
  37     next: () => goTo(sessionIndex, roundIndex + 1),
  38     finishedIn: (i: number) => sessions[i].rounds.every((r) => !!save.rounds[r.id]),
  39     nextSession: () => goTo(sessionIndex + 1, 0),
  40     replay: () => goTo(sessionIndex, 0),
  41     goToSession: (s: number) => goTo(s, 0),
  42     sessions,
  43     complete: (marks: number, max: number, firstTry: boolean, phrases: string[]) => {
  44       update((s) => recordRound(s, round.id, { marks, max, firstTry }, phrases));
  45       track("round_completed", { game, round: round.id, firstTry, marks });
  46     },
  47   };
  48 }

