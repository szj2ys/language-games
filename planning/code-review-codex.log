 127 /** Returns false when the browser refuses to store (private mode, quota, blocked). */
 128 export function writeSave(save: Save): boolean {
 129   try {
 130     const current = parseSave(window.localStorage.getItem(SAVE_KEY));
 131     // Never overwrite a save written by a newer version of the app.
 132     if (!current.ok && current.reason === "newer") return false;
 133     const merged = current.ok ? mergeSaves(current.save, save) : save;
 134     window.localStorage.setItem(SAVE_KEY, JSON.stringify(merged));
 135     return true;
 136   } catch {
 137     return false;
 138   }
 139 }
