files=sorted(r.glob('p-*.png'))+[r/f'{x}-end.png' for x in ['builder','cafe','family','pupil']]
for batch in range(0,len(files),6):
 sheet=Image.new('RGB',(1170,1900),'white'); d=ImageDraw.Draw(sheet)
 for i,p in enumerate(files[batch:batch+6]):
  im=Image.open(p); im.thumbnail((380,910)); x=i%3*390; y=i//3*950; d.text((x+5,y+5),p.stem,fill='black'); sheet.paste(im,(x,y+25))
 sheet.save(r/f'contact-pupil-{batch//6}.jpg')
a=json.loads((r/'actions.json').read_text(encoding='utf-8'))
for before,after in [('b4-2-wrong','b4-2-reload'),('c4-2-wrong','c4-2-reload'),('f3-1-wrong','f3-1-reload'),('f3-3-morse-writing-rejected','f3-3-reload'),('p-5-example','p-5-reload'),('p-5-twist','p-5-twist-reload'),('p-6-example','p-6-reload'),('p-6-twist','p-6-twist-reload')]:
 b=next(x for x in reversed(a) if x['name']==before); c=next(x for x in reversed(a) if x['name']==after); print(before,'reload text same:',b['text']==c['text'])
checks=[]
for folder in ['rounds','after']:
 for i in range(1,7):
  url=f'http://localhost:3417/art/cafe/{folder}/c4-{i}.webp'
  try:
   with urllib.request.urlopen(url) as response: status=response.status
  except urllib.error.HTTPError as error: status=error.code
  checks.append({'url':url,'status':status,'exists_on_disk':Path(f'public/art/cafe/{folder}/c4-{i}.webp').exists()})
Path('qa/playtest-2/asset-check.json').write_text(json.dumps(checks,indent=2))
print('Direct assets:',checks)
