+from pathlib import Path
+import json, re, sys
+from playwright.sync_api import sync_playwright, expect
+
+sys.stdout.reconfigure(encoding='utf-8')
+ROOT = Path(__file__).resolve().parent
+OUT = ROOT / 'phone'
+OUT.mkdir(exist_ok=True)
+LOG = json.loads((OUT/'actions.json').read_text(encoding='utf-8')) if (OUT/'actions.json').exists() else []
+
+def capture(page, name):
+    page.wait_for_timeout(550)
+    page.evaluate('window.scrollTo(0,0)')
+    page.screenshot(path=str(OUT / f'{name}.png'), full_page=True)
+    entry = {'name': name, 'url': page.url, 'text': page.locator('body').inner_text(),
+             'overflow': page.evaluate('document.documentElement.scrollWidth > innerWidth'),
+             'images': page.locator('img').evaluate_all('(xs)=>xs.map(x=>({src:x.currentSrc,ok:x.complete&&x.naturalWidth>0}))')}
+    LOG.append(entry)
+    (OUT / 'actions.json').write_text(json.dumps(LOG, ensure_ascii=False, indent=2), encoding='utf-8')
+    print(name, flush=True)
+
+def tap(page, text):
+    page.get_by_role('button', name=text, exact=True).tap()
+    page.wait_for_timeout(250)
+
+def start(page, game, title):
+    page.goto(f'http://localhost:3417/play/{game}', wait_until='domcontentloaded')
+    page.get_by_role('navigation', name='Sessions').get_by_role('button', name=re.compile(re.escape(title))).tap()
+    page.wait_for_timeout(400)
+
+def choice_games(page):
+    start(page, 'builder', 'Order or report?')
+    correct = ['Bring him three slabs.', 'Write “3 slabs” on the stock list.', 'Answer: “No — it\'s a beam.”', 'Jump out of the way.', 'Ask: “Which one — the big one or the small one?”', 'Write “2 beams” on the stock list.']
+    wrong = ['Write “3 slabs” on the stock list.', 'Carry three slabs to her.', None, None, None, None]
+    for i in range(3 if 'resume' in sys.argv else 0,6):
+        name=f'b4-{i+1}'
+        capture(page,name+'-start')
+        opts=page.locator('button[data-shortcut]')
+        if i >= 2:
+            labels=opts.all_inner_texts()
+            print(labels,flush=True)
+            target=next((x for x in labels if correct[i] in x),None)
+            if target is None:
+                print('STOP: inspect labels',flush=True); return
+        if wrong[i]:
+            page.get_by_role('button',name=re.compile(re.escape(wrong[i]))).tap()
+        else:
+            for opt in opts.all():
+                if correct[i] not in opt.inner_text():
+                    opt.tap(); break
+        capture(page,name+'-wrong')
+        if i == 1:
+            page.reload(wait_until='domcontentloaded'); capture(page,name+'-reload')
+        page.get_by_role('button',name=re.compile(re.escape(correct[i]))).tap()
+        capture(page,name+'-solved')
+        tap(page,'Next')
+    capture(page,'builder-end')
+
+def cafe(page):
+    start(page,'cafe','Sorry, thanks, no problem')
+    for i,good in enumerate([1,2,0,1,2,0]):
+        name=f'c4-{i+1}'
+        capture(page,name+'-start')
+        opts=page.locator('button[data-shortcut]')
+        opts.nth((good+1)%3).tap(); capture(page,name+'-wrong')
+        if i == 1:
+            page.reload(wait_until='domcontentloaded'); capture(page,name+'-reload')
+            page.get_by_role('button',name=re.compile('Do you want to get past')).tap(); capture(page,name+'-asked')
+        opts.nth(good).tap(); capture(page,name+'-solved')
+        tap(page,'Next')
+    capture(page,'cafe-end')
+
+def family(page):
+    start(page,'family','What is a language?')
+    for i,answer in enumerate(['Some','Most']):
+        name=f'f3-{i+1}'
+        capture(page,name+'-start')
+        page.get_by_role('radio',name='All',exact=True).tap(); tap(page,'Look')
+        capture(page,name+'-wrong')
+        if i == 0:
+            page.reload(wait_until='domcontentloaded'); capture(page,name+'-reload')
+        page.get_by_role('radio',name=answer,exact=True).tap(); tap(page,'Look')
+        capture(page,name+'-solved'); tap(page,'Next')
+    capture(page,'f3-3-start')
+    tap(page,'English'); tap(page,'Morse code'); tap(page,'can be written down')
+    capture(page,'f3-3-morse-writing-rejected')
+    page.reload(wait_until='domcontentloaded'); capture(page,'f3-3-reload')
+    tap(page,'can tell a story'); capture(page,'f3-3-morse-story-rejected')
+    tap(page,'can give orders')
+    for name,link in [('sign language','are used with the hands'),('road signs','can give orders'),('chemical formulas','are used for one special job'),('music notation','can be written down')]:
+        tap(page,name); tap(page,link)
+    capture(page,'f3-3-solved'); tap(page,'Next')
+    capture(page,'f3-4-start')
+    page.get_by_role('combobox',name='What they share').select_option('written'); tap(page,'Say it')
+    capture(page,'f3-4-wrong')
+    page.get_by_role('combobox',name='What they share').select_option('spoken'); tap(page,'Say it')
+    capture(page,'f3-4-solved'); tap(page,'Next'); capture(page,'family-end')
+
+def pupil(page):
+    start(page,'pupil','Rules with no rule')
+    for i in range(2):
+        name=f'p-{i+5}'
+        capture(page,name+'-start')
+        page.get_by_role('group',name='Explain the rule in words').get_by_role('button').first.tap()
+        capture(page,name+'-bad-explanation')
+        page.get_by_role('group',name='Example cards').get_by_role('button',name='mind swimming' if i==0 else 'two pieces of equipment',exact=True).tap()
+        capture(page,name+'-example')
+        page.reload(wait_until='domcontentloaded'); capture(page,name+'-reload')
+        if page.get_by_role('group',name='Example cards').count():
+            page.get_by_role('group',name='Explain the rule in words').get_by_role('button').nth(1).tap()
+        capture(page,name+'-trained')
+        tap(page,"Now a word it hasn't seen"); capture(page,name+'-twist')
+        page.reload(wait_until='domcontentloaded'); capture(page,name+'-twist-reload')
+        tap(page,'Correct it'); capture(page,name+'-wrong-twist')
+        tap(page,'Next')
+    capture(page,'pupil-end')
+
+if __name__ == '__main__':
+    with sync_playwright() as pw:
+        browser=pw.chromium.launch(headless=True)
+        context=browser.new_context(viewport={'width':390,'height':844},is_mobile=True,has_touch=True,device_scale_factor=1,storage_state=str(OUT/'storage.json') if 'resume' in sys.argv else None)
+        page=context.new_page(); page.set_default_timeout(8000)
+        errors=json.loads((OUT/'errors.json').read_text()) if (OUT/'errors.json').exists() else []
+        page.on('pageerror',lambda e:errors.append(str(e)))
+        page.on('response',lambda r:errors.append(f'HTTP {r.status} {r.url}') if r.status>=400 else None)
+        try:
+            if 'family' in sys.argv: family(page)
+            elif 'pupil' in sys.argv: pupil(page)
+            elif 'cafe' in sys.argv: cafe(page)
+            else: choice_games(page)
+        finally:
+            (OUT/'errors.json').write_text(json.dumps(errors,indent=2),encoding='utf-8')
+            context.storage_state(path=str(OUT/'storage.json'))
+            browser.close()

