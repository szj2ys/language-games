"use client";

import { useEffect, useState } from "react";

const PREFIX = "language-games:draft:";

/**
 * Round state that survives a reload: half-built calls, placed objects, cards
 * shown. Keyed by round id; cleared when the player moves on.
 */
export function useDraft<T>(round: string, field: string, initial: T | (() => T)) {
  const key = `${PREFIX}${round}:${field}`;
  const [value, setValue] = useState<T>(() => {
    try {
      const raw = window.localStorage.getItem(key);
      if (raw !== null) return JSON.parse(raw) as T;
    } catch {
      // Unreadable draft: start the round fresh.
    }
    return typeof initial === "function" ? (initial as () => T)() : initial;
  });
  useEffect(() => {
    try {
      window.localStorage.setItem(key, JSON.stringify(value));
    } catch {
      // Storage full or blocked: the round still works in memory.
    }
  }, [key, value]);
  return [value, setValue] as const;
}

export function clearDrafts(round?: string) {
  try {
    const store = window.localStorage;
    const prefix = round ? `${PREFIX}${round}:` : PREFIX;
    for (let i = store.length - 1; i >= 0; i--) {
      const k = store.key(i);
      if (k?.startsWith(prefix)) store.removeItem(k);
    }
  } catch {
    // Nothing to clear.
  }
}
"use client";

import { track } from "@/components/analytics";
import { recordRound, resolvePosition } from "@/lib/progress";
import { useSave, useSpeech } from "@/lib/use-save";
import { clearDrafts } from "@/lib/use-draft";

type SessionLike = { rounds: { id: string }[] };

/**
 * Where the player is in a game's sessions, saved locally so a reload resumes the same round.
 * `did` names what a round showed (the game's own content module defines it).
 */
export function useSessions<S extends SessionLike>(game: string, sessions: S[], did: (r: S["rounds"][number]) => string) {
  const { save, ready, update, storable } = useSave();
  // A saved place counts only if the rounds before it were played: content can change between visits.
  const { session: sessionIndex, round: roundIndex, finished } = resolvePosition(sessions, save.rounds, save.positions[game]);
  const session = sessions[sessionIndex];
  const round = session.rounds[roundIndex] as S["rounds"][number];
  const speech = useSpeech(save.settings.speech);

  const goTo = (s: number, r: number) => {
    for (const x of session.rounds) clearDrafts(x.id);
    return update((sv) => ({ ...sv, lastGame: game, positions: { ...sv.positions, [game]: { session: s, round: r } } }));
  };

  return {
    save,
    ready,
    storable,
    session,
    sessionIndex,
    round,
    roundIndex,
    finished,
    speech,
    toggleSpeech: () => update((s) => ({ ...s, settings: { ...s.settings, speech: !s.settings.speech } })),
    next: () => goTo(sessionIndex, roundIndex + 1),
    /** What the player said in each round of this session, and the job those words did. */
    sessionItems: () =>
      session.rounds
        .map((r) => ({ text: save.rounds[r.id]?.said?.[0], did: did(r) }))
        .filter((x): x is { text: string; did: string } => !!x.text),
    finishedIn: (i: number) => sessions[i].rounds.every((r) => !!save.rounds[r.id]),
    nextSession: () => goTo(sessionIndex + 1, 0),
    replay: () => goTo(sessionIndex, 0),
    goToSession: (s: number) => goTo(s, 0),
    sessions,
    complete: (marks: number, max: number, firstTry: boolean, phrases: string[], missed?: string) => {
      update((s) => recordRound(s, round.id, { marks, max, firstTry, ...(missed ? { missed } : {}) }, phrases));
      track("round_completed", { game, round: round.id, firstTry, marks });
    },
  };
}
"use client";

import Link from "next/link";
import { ArrowRight } from "lucide-react";
import { buttonVariants } from "@/components/ui/button";
import { GAMES } from "@/content/games";
import { SOURCES } from "@/content/sources";
import { useSave } from "@/lib/use-save";
import { cn } from "@/lib/utils";

/** Continue where you left off; a first visit starts at the first idea. */
export function ContinueButton() {
  const { save, ready } = useSave();
  const last = ready ? GAMES.find((g) => g.slug === save.lastGame) : undefined;
  const target = last ?? GAMES[0];
  return (
    <Link href={`/play/${target.slug}`} className={cn(buttonVariants({ size: "lg" }), "h-13 px-6 text-lg")}>
      {last ? `Continue: ${last.step}. ${last.title}` : "Start with the first idea"} <ArrowRight className="size-5" aria-hidden />
    </Link>
  );
}

export function GameProgress({ rounds }: { rounds: string[] }) {
  const { save, ready } = useSave();
  if (!ready) return null;
  const done = rounds.filter((id) => save.rounds[id]).length;
  if (done === 0) return null;
  return (
    <span className="shrink-0 rounded-full bg-sage/15 px-2 py-0.5 text-[13px] font-bold text-sage">
      {done === rounds.length ? "Done" : `${done}/${rounds.length}`}
    </span>
  );
}

/** When every round is done: no streak, no "come back tomorrow" — the ladder can be thrown away. */
export function LadderEnd() {
  const { save, ready } = useSave();
  if (!ready) return null;
  const all = GAMES.flatMap((g) => g.rounds);
  if (!all.every((id) => save.rounds[id])) return null;
  const ladder = SOURCES["tlp-6.54"];
  const stop = SOURCES["pi-133"];
  return (
    <section className="mt-8 rounded-lg border border-border bg-card p-5" aria-labelledby="ladder">
      <h2 id="ladder" className="font-heading text-2xl font-semibold">
        You have walked the whole path.
      </h2>
      <p className="mt-2 text-[17px] leading-relaxed">
        That is the end — there is no streak to keep. In the Tractatus Wittgenstein says of his own book: “{ladder.quote}” ({ladder.ref}).
        Later he put it differently: “{stop.quote}” (PI {stop.ref}). Now read him: the passages are all on the sources page.
      </p>
    </section>
  );
}

