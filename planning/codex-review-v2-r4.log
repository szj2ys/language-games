@@ -0,0 +1,38 @@
+import hashlib, json, re, subprocess
+from pathlib import Path
+
+OUT = Path(__file__).resolve().parent
+ROOT = OUT.parents[1]
+report = ROOT/'planning/codex-review-v2-r4.md'
+body = report.read_text(encoding='utf8')
+baseline = json.loads((OUT/'protected-baseline.json').read_text(encoding='utf8'))
+current = {str(p.relative_to(ROOT)).replace('\\','/'):hashlib.sha256(p.read_bytes()).hexdigest()
+           for folder in ['src','public','e2e','art'] for p in (ROOT/folder).rglob('*') if p.is_file()}
+changed = [p for p in baseline if baseline[p] != current.get(p)]
+added = sorted(set(current)-set(baseline))
+early = json.loads((OUT/'early-games/coverage.json').read_text())
+late = json.loads((OUT/'late-games/coverage.json').read_text())
+totals = {device:sum(g['completed'] for g in early[device].values())+len(late['devices'][device]['completed_rounds']) for device in ['phone','desktop']}
+checks = {'first_line':body.splitlines()[0]=='VERDICT: SATISFIED',
+          'ending':body.strip().split('\n')[-1].startswith('Not covered:'),
+          'prior_two':all('R3-'+str(n)+':' in body for n in range(1,3)),
+          'four_minor_findings':all('R4-'+str(n)+' — minor' in body for n in range(1,5)),
+          'completed_111_each':totals=={'phone':111,'desktop':111},
+          'unchanged_protected':not changed and not added}
+paths = set(re.findall(r'`((?:qa/codex-review-r4/|src/|planning/|art/)[^`]+)`',body))
+paths.update(re.findall(r'\]\((\.\./qa/[^)]+)\)',body))
+paths.discard('qa/codex-review-r4/integrity.json')
+missing=[]
+for name in paths:
+    name=re.sub(r':\d+$','',name)
+    p=report.parent/name if name.startswith('../') else ROOT/name
+    if not p.exists():missing.append(name)
+checks['explicit_evidence_paths_exist']=not missing
+data={'head':subprocess.check_output(['git','rev-parse','HEAD'],cwd=ROOT,text=True).strip(),
+      'protected_files':len(baseline),'changed_protected':changed,'added_protected':added,
+      'completed_rounds':totals,'report_checks':checks,'missing_report_paths':missing,
+      'report_sha256':hashlib.sha256(report.read_bytes()).hexdigest(),
+      'scope':'Format, file hashes, reference existence and coverage counts only. Does not judge report accuracy, philosophical correctness, design quality, or absence of bugs.'}
+(OUT/'integrity.json').write_text(json.dumps(data,indent=2),encoding='utf8')
+print(json.dumps(data,indent=2))
+assert all(checks.values())

