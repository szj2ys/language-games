+import json
+from pathlib import Path
+from playwright.sync_api import sync_playwright, expect
+from PIL import Image, ImageOps, ImageDraw
+
+OUT = Path(__file__).resolve().parent
+ROOT = OUT.parents[1]
+BASE = 'http://localhost:3417'
+content = json.loads((OUT/'philosophy/current-content.json').read_text(encoding='utf8'))
+expected = {r['id'] for g in content['games'].values() for s in g['sessions'] for r in s['rounds']}
+results = []
+
+def read_save(path):
+    state = json.loads(path.read_text(encoding='utf8'))
+    return json.loads(next(i['value'] for o in state['origins'] for i in o['localStorage'] if i['name']=='language-games:v1'))
+
+with sync_playwright() as pw:
+    b = pw.chromium.launch()
+    for device,vp,touch in [('phone',{'width':390,'height':844},True),('desktop',{'width':1440,'height':900},False)]:
+        a = read_save(OUT/'early-games'/device/'storage.json')
+        z = read_save(OUT/'late-games'/device/'storage.json')
+        a['rounds'].update(z['rounds']); a['positions'].update(z['positions'])
+        a['phrases'] += z['phrases']; a['lastGame'] = 'hinges'
+        missing = sorted(expected-set(a['rounds']))
+        assert not missing, (device, missing)
+        state = {'cookies':[], 'origins':[{'origin':BASE,'localStorage':[{'name':'language-games:v1','value':json.dumps(a)}]}]}
+        (OUT/'root'/f'{device}-all-complete-storage.json').write_text(json.dumps(state),encoding='utf8')
+        c = b.new_context(viewport=vp,is_mobile=touch,has_touch=touch,storage_state=state)
+        p = c.new_page(); p.goto(BASE,wait_until='networkidle')
+        assert p.get_by_role('heading',name='You have walked the whole path.').is_visible()
+        p.screenshot(path=str(OUT/'root'/f'{device}-all-complete-home.png'),full_page=True)
+        results.append({'device':device,'test':'all-complete-home','roundCount':len(expected),'ladder':p.locator('#ladder').inner_text(),'body':p.locator('main').inner_text()})
+        p.get_by_role('link',name='Notebook',exact=True).click()
+        expect(p.get_by_role('link',name='Play again',exact=True)).to_have_count(22)
+        p.screenshot(path=str(OUT/'root'/f'{device}-all-complete-notebook.png'),full_page=True)
+        p.get_by_role('link',name='Sources',exact=True).click()
+        p.wait_for_url('**/sources')
+        expect(p.locator('main:visible blockquote')).to_have_count(45)
+        ids = list(content['sources'])
+        anchors = p.evaluate('(ids)=>ids.map(id=>({id,exists:!!document.getElementById(id)}))', ids)
+        assert all(x['exists'] for x in anchors)
+        p.locator('#w-PI').scroll_into_view_if_needed()
+        p.screenshot(path=str(OUT/'root'/f'{device}-sources-pi-edition.png'))
+        p.locator('#pi-ppf-118').scroll_into_view_if_needed()
+        p.screenshot(path=str(OUT/'root'/f'{device}-sources-part-two.png'))
+        results.append({'device':device,'test':'complete-notebook-sources','sessions':22,'sourceAnchors':anchors})
+        c.close()
+    b.close()
+(OUT/'root/final-checks.json').write_text(json.dumps(results,indent=2),encoding='utf8')
+
+# Contact sheets retain every vertical portion of the full-page captures.
+folder=OUT/'root/sheets'; folder.mkdir(exist_ok=True)
+for device,vp in [('phone',(390,844)),('desktop',(1440,900))]:
+    paths = sorted((OUT/'root').glob(device+'-*.png'))
+    paths += sorted((OUT/'root'/device).glob('*.png'))
+    tiles=[]
+    for path in paths:
+        im=Image.open(path).convert('RGB')
+        # Full-width desktop pages are reviewed at 50%; phone at 75%.
+        scale=.5 if device=='desktop' else .75
+        for y in range(0,im.height,vp[1]):
+            crop=im.crop((0,y,im.width,min(im.height,y+vp[1])))
+            tiles.append((path.name+f' y={y}',crop.resize((int(crop.width*scale),int(crop.height*scale)))))
+    width=int(vp[0]*scale); height=int(vp[1]*scale)
+    for start in range(0,len(tiles),6):
+        sheet=Image.new('RGB',(width*2,(height+24)*3),'#ddd'); draw=ImageDraw.Draw(sheet)
+        for i,(label,im) in enumerate(tiles[start:start+6]):
+            x=i%2*width; y=i//2*(height+24)
+            draw.text((x+4,y+4),label,fill='black'); sheet.paste(im,(x,y+24))
+        sheet.save(folder/f'{device}-{start//6+1:02}.jpg')
+print(json.dumps({'completeRoundsPerDevice':len(expected),'sheets':len(list(folder.glob('*.jpg')))}))
