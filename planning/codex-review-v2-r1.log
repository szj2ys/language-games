@@ -0,0 +1,89 @@
+"""Read-only phone review of the already running production server."""
+import hashlib
+import importlib.util
+import json
+import re
+import sys
+import traceback
+from pathlib import Path
+
+from playwright.sync_api import sync_playwright
+
+ROOT = Path(__file__).resolve().parents[2]
+OUT = ROOT / "qa/codex-review-r1/phone"
+OUT.mkdir(parents=True, exist_ok=True)
+BASE = "http://localhost:3417"
+spec = importlib.util.spec_from_file_location("journey", ROOT / "e2e/play_all.py")
+journey = importlib.util.module_from_spec(spec)
+spec.loader.exec_module(journey)
+journey.SHOTS = OUT
+records = []
+counter = 0
+
+def capture(page, name):
+    global counter
+    counter += 1
+    page.wait_for_timeout(220)
+    for _ in range(35):
+        if page.evaluate("() => [...document.images].every(i => i.complete)"):
+            break
+        page.wait_for_timeout(100)
+    filename = f"{counter:03d}-{name}.png"
+    page.screenshot(path=str(OUT / filename))
+    records.append({"event": "capture", "name": name, "url": page.url,
+                    "screenshot": filename, "text": page.locator("body").inner_text(),
+                    "viewport": page.viewport_size,
+                    "scroll": page.evaluate("() => ({x:scrollX,y:scrollY,w:document.documentElement.scrollWidth,h:document.documentElement.scrollHeight})"),
+                    "sessions": page.get_by_role("navigation", name="Sessions").inner_text() if page.get_by_role("navigation", name="Sessions").count() else None})
+    (OUT / "observations.json").write_text(json.dumps(records, indent=2), encoding="utf-8")
+
+journey.shot = capture
+original_pick = journey.pick_session
+def pick(page, title):
+    original_pick(page, title)
+    capture(page, "session-" + re.sub(r"[^a-z0-9]+", "-", title.lower()))
+journey.pick_session = pick
+
+manifest = {}
+for folder in ["src", "public", "e2e", "art"]:
+    for path in (ROOT / folder).rglob("*"):
+        if path.is_file():
+            manifest[str(path.relative_to(ROOT))] = hashlib.sha256(path.read_bytes()).hexdigest()
+(OUT / "protected-files-baseline.json").write_text(json.dumps(manifest, indent=2), encoding="utf-8")
+
+with sync_playwright() as p:
+    browser = p.chromium.launch()
+    ctx = browser.new_context(viewport={"width":390,"height":844}, is_mobile=True, has_touch=True, device_scale_factor=1)
+    page = ctx.new_page()
+    page.set_default_timeout(9000)
+    page.on("pageerror", lambda err: records.append({"event":"pageerror","error":str(err)}))
+    page.on("console", lambda msg: records.append({"event":"console","type":msg.type,"text":msg.text}) if msg.type=="error" else None)
+    page.goto(BASE)
+    capture(page,"home-fresh")
+    page.get_by_role("link", name="Start with the first idea").click()
+    capture(page,"home-start-scene")
+    for slug in ["scene","builder","cafe","family","pupil","beetle","hinges"]:
+        page.goto(BASE + "/play/" + slug)
+        capture(page,slug+"-initial")
+    for slug in ["sources","notebook"]:
+        page.goto(BASE + "/" + slug)
+        capture(page,slug+"-fresh")
+    for label, fn in [("builder",journey.play_builder),("scene",journey.play_scene),
+                      ("cafe",journey.play_cafe),("pupil",journey.play_pupil),
+                      ("family",journey.play_family),("later",journey.play_later_sessions),
+                      ("choice",journey.play_choice_games)]:
+        try:
+            fn(page)
+            records.append({"event":"journey", "name":label,"result":"completed"})
+            print(label + ": completed", flush=True)
+        except Exception as exc:
+            capture(page,label+"-failure")
+            records.append({"event":"journey", "name":label,"result":"failed", "error":str(exc),"trace":traceback.format_exc()})
+            print(label + ": " + str(exc), flush=True)
+    for slug in ["notebook", "sources", ""]:
+        page.goto(BASE + "/" + slug)
+        capture(page,(slug or "home")+"-after-games")
+        page.screenshot(path=str(OUT / ((slug or "home")+"-full.png")),full_page=True)
+    ctx.storage_state(path=str(OUT / "completed-storage.json"))
+    (OUT / "observations.json").write_text(json.dumps(records, indent=2), encoding="utf-8")
+    browser.close()

