@@ -0,0 +1,21 @@
+"""Assemble captured evidence for visual review without changing source images."""
+from pathlib import Path
+from PIL import Image, ImageDraw
+
+root = Path(__file__).resolve().parent
+out = root / "phone-contact-sheets"
+out.mkdir(exist_ok=True)
+for folder in ["phone", "phone-endcards", "phone-edges"]:
+    files = sorted(p for p in (root / folder).glob("*.png") if folder != "phone" or p.name[0].isdigit())
+    for offset in range(0,len(files),6):
+        group = files[offset:offset+6]
+        sheet = Image.new("RGB", (1170,1756), "#dedbd3")
+        draw = ImageDraw.Draw(sheet)
+        for index,path in enumerate(group):
+            image = Image.open(path).convert("RGB")
+            image.thumbnail((390,844))
+            x,y = (index%3)*390,(index//3)*878
+            draw.text((x+5,y+5),path.name,fill="black")
+            sheet.paste(image,(x,y+30))
+        sheet.save(out / (folder+"-"+str(offset//6+1)+".jpg"),quality=88)
+print(out)
