counter=0
log=[]
def capture(page,name):
    global counter
    counter+=1
    page.wait_for_timeout(120)
    for _ in range(25):
        if page.evaluate('() => [...document.images].every(i=>i.complete)'):break
        page.wait_for_timeout(100)
    path=OUT/f'{counter:03d}-{name}.png'
    page.screenshot(path=str(path))
    data={'name':name,'screenshot':str(path.relative_to(ROOT)),'url':page.url,'body':page.locator('body').inner_text(),'overflow':page.evaluate('document.documentElement.scrollWidth > innerWidth')}
    log.append(data)
    (OUT/'journey.json').write_text(json.dumps(log,ensure_ascii=False,indent=2),encoding='utf-8')
    return data
j.shot=capture
old_next=j.next_round
def next_round(page):
    old_next(page)
    capture(page,'after-next')
j.next_round=next_round
old_pick=j.pick_session
def pick(page,title):
    capture(page,'before-session-change')
    old_pick(page,title)
    capture(page,'session-'+re.sub('[^a-z0-9]+','-',title.lower()))
j.pick_session=pick

