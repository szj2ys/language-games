@@ -0,0 +1,50 @@
+"""Exercise wrong attempts, reloads and phone end-card placement."""
+import json
+import re
+from pathlib import Path
+from playwright.sync_api import sync_playwright
+
+ROOT = Path(__file__).resolve().parents[2]
+OUT = ROOT / "qa/codex-review-r1/phone-edges"
+OUT.mkdir(parents=True, exist_ok=True)
+BASE = "http://localhost:3417"
+results = json.loads((OUT / "reloads.json").read_text()) if (OUT / "reloads.json").exists() else []
+
+with sync_playwright() as p:
+    browser = p.chromium.launch()
+    ctx = browser.new_context(viewport={"width":390,"height":844}, is_mobile=True, has_touch=True)
+    page = ctx.new_page()
+    for slug in ["builder","scene","cafe","pupil","family","beetle","hinges"]:
+        if any(result["slug"] == slug for result in results):
+            continue
+        page.goto(BASE + "/play/" + slug)
+        page.wait_for_timeout(350)
+        if slug == "builder":
+            page.get_by_role("button", name="pillar", exact=True).tap()
+        elif slug == "scene":
+            page.get_by_role("button", name="key", exact=True).tap()
+            page.get_by_role("button", name="Front row, place 1 from the left").tap()
+            page.get_by_role("button", name="Is it true?", exact=True).tap()
+        elif slug == "cafe":
+            page.get_by_role("button", name=re.compile("Yes, it's November")).tap()
+        elif slug == "pupil":
+            page.get_by_role("button", name=re.compile("Explain:.*before a vowel")).first.tap()
+            page.get_by_role("button", name="an egg", exact=True).tap()
+        elif slug == "family":
+            page.get_by_role("radio", name="All", exact=True).tap()
+            page.get_by_role("button", name="Look", exact=True).tap()
+        elif slug == "beetle":
+            page.get_by_role("button", name="Yes: put the boxes side by side and compare.", exact=True).tap()
+        elif slug == "hinges":
+            page.get_by_role("button", name="Nothing could ever settle it.", exact=True).tap()
+        page.wait_for_timeout(250)
+        before = page.locator("body").inner_text()
+        page.screenshot(path=str(OUT / (slug+"-before-reload.png")))
+        page.reload()
+        page.wait_for_timeout(450)
+        after = page.locator("body").inner_text()
+        page.screenshot(path=str(OUT / (slug+"-after-reload.png")))
+        results.append({"slug":slug,"before":before,"after":after,"same_text":before==after})
+        (OUT / "reloads.json").write_text(json.dumps(results,indent=2),encoding="utf-8")
+        print(slug, before==after, flush=True)
+    browser.close()
diff --git a/qa/codex-review-r1/phone_endcards.py b/qa/codex-review-r1/phone_endcards.py
new file mode 100644
index 0000000000000000000000000000000000000000..eaac13331eebd6efbd825d3d57b8c6255d119866
--- /dev/null
+++ b/qa/codex-review-r1/phone_endcards.py
@@ -0,0 +1,47 @@
+"""Inspect all end cards using the completed records from the real phone journey.
+
+Only the navigation cursor is restored; completed rounds and answers are unchanged.
+This is visual inspection evidence, not a substitute for the separate played journey.
+"""
+import copy
+import json
+from pathlib import Path
+from playwright.sync_api import sync_playwright
+
+ROOT = Path(__file__).resolve().parents[2]
+OUT = ROOT / "qa/codex-review-r1/phone-endcards"
+OUT.mkdir(parents=True, exist_ok=True)
+state = json.loads((ROOT / "qa/codex-review-r1/phone/completed-storage.json").read_text())
+lengths = {"scene":[6,6,6,6],"builder":[6,6,6,6],"cafe":[6,6,6,6],
+           "family":[6,5,4,4],"pupil":[4,2,2],"beetle":[5,5],"hinges":[5,5]}
+rows = []
+with sync_playwright() as p:
+    browser = p.chromium.launch()
+    for slug, counts in lengths.items():
+        for index, count in enumerate(counts):
+            saved = copy.deepcopy(state)
+            item = next(x for x in saved["origins"][0]["localStorage"] if x["name"]=="language-games:v1")
+            progress = json.loads(item["value"])
+            progress["positions"][slug] = {"session":index,"round":count}
+            item["value"] = json.dumps(progress)
+            ctx = browser.new_context(viewport={"width":390,"height":844}, is_mobile=True, has_touch=True, storage_state=saved)
+            page = ctx.new_page()
+            page.goto("http://localhost:3417/play/" + slug)
+            page.get_by_role("button",name="Play again",exact=True).wait_for()
+            page.wait_for_timeout(250)
+            page.evaluate("() => scrollTo(0,0)")
+            filename = slug+"-session-"+str(index+1)+".png"
+            page.screenshot(path=str(OUT / filename))
+            heading = page.get_by_role("heading",level=2).first
+            next_action = page.get_by_role("button",name="Next:",exact=False)
+            if not next_action.count():
+                next_action = page.get_by_role("link",name="Next idea:",exact=False)
+            rows.append({"slug":slug,"session":index+1,"screenshot":filename,
+                         "heading":heading.inner_text(),"heading_box":heading.bounding_box(),
+                         "next":next_action.inner_text(),"next_box":next_action.bounding_box(),
+                         "body":page.locator("body").inner_text()})
+            ctx.close()
+    browser.close()
+(OUT / "measurements.json").write_text(json.dumps(rows,indent=2),encoding="utf-8")
+print("Inspected",len(rows),"completed-session end cards")
+print("Next action below viewport:",sum(r["next_box"]["y"]>=844 for r in rows))
diff --git a/qa/codex-review-r1/phone_review.py b/qa/codex-review-r1/phone_review.py
new file mode 100644
index 0000000000000000000000000000000000000000..b11782cf09f0e97e49fd4b05d6f29bdde50bfde5
--- /dev/null
+++ b/qa/codex-review-r1/phone_review.py
@@ -0,0 +1,89 @@
+"""Read-only phone review of the already running production server."""
+import hashlib
+import importlib.util
+import json
+import re
+import sys
+import traceback
+from pathlib import Path
+
+from playwright.sync_api import sync_playwright
+
+ROOT = Path(__file__).resolve().parents[2]
+OUT = ROOT / "qa/codex-review-r1/phone"
+OUT.mkdir(parents=True, exist_ok=True)
+BASE = "http://localhost:3417"
+spec = importlib.util.spec_from_file_location("journey", ROOT / "e2e/play_all.py")
+journey = importlib.util.module_from_spec(spec)
+spec.loader.exec_module(journey)
+journey.SHOTS = OUT
+records = []
+counter = 0
+
+def capture(page, name):
+    global counter
+    counter += 1
+    page.wait_for_timeout(220)
+    for _ in range(35):
+        if page.evaluate("() => [...document.images].every(i => i.complete)"):
+            break
+        page.wait_for_timeout(100)
+    filename = f"{counter:03d}-{name}.png"
+    page.screenshot(path=str(OUT / filename))
+    records.append({"event": "capture", "name": name, "url": page.url,
+                    "screenshot": filename, "text": page.locator("body").inner_text(),
+                    "viewport": page.viewport_size,
+                    "scroll": page.evaluate("() => ({x:scrollX,y:scrollY,w:document.documentElement.scrollWidth,h:document.documentElement.scrollHeight})"),
+                    "sessions": page.get_by_role("navigation", name="Sessions").inner_text() if page.get_by_role("navigation", name="Sessions").count() else None})
+    (OUT / "observations.json").write_text(json.dumps(records, indent=2), encoding="utf-8")
+
+journey.shot = capture
+original_pick = journey.pick_session
+def pick(page, title):
+    original_pick(page, title)
+    capture(page, "session-" + re.sub(r"[^a-z0-9]+", "-", title.lower()))
+journey.pick_session = pick
+
+manifest = {}
+for folder in ["src", "public", "e2e", "art"]:
+    for path in (ROOT / folder).rglob("*"):
+        if path.is_file():
+            manifest[str(path.relative_to(ROOT))] = hashlib.sha256(path.read_bytes()).hexdigest()
+(OUT / "protected-files-baseline.json").write_text(json.dumps(manifest, indent=2), encoding="utf-8")
+
+with sync_playwright() as p:
+    browser = p.chromium.launch()
+    ctx = browser.new_context(viewport={"width":390,"height":844}, is_mobile=True, has_touch=True, device_scale_factor=1)
+    page = ctx.new_page()
+    page.set_default_timeout(9000)
+    page.on("pageerror", lambda err: records.append({"event":"pageerror","error":str(err)}))
+    page.on("console", lambda msg: records.append({"event":"console","type":msg.type,"text":msg.text}) if msg.type=="error" else None)
+    page.goto(BASE)
+    capture(page,"home-fresh")
+    page.get_by_role("link", name="Start with the first idea").click()
+    capture(page,"home-start-scene")
+    for slug in ["scene","builder","cafe","family","pupil","beetle","hinges"]:
+        page.goto(BASE + "/play/" + slug)
+        capture(page,slug+"-initial")
+    for slug in ["sources","notebook"]:
+        page.goto(BASE + "/" + slug)
+        capture(page,slug+"-fresh")
+    for label, fn in [("builder",journey.play_builder),("scene",journey.play_scene),
+                      ("cafe",journey.play_cafe),("pupil",journey.play_pupil),
+                      ("family",journey.play_family),("later",journey.play_later_sessions),
+                      ("choice",journey.play_choice_games)]:
+        try:
+            fn(page)
+            records.append({"event":"journey", "name":label,"result":"completed"})
+            print(label + ": completed", flush=True)
+        except Exception as exc:
+            capture(page,label+"-failure")
+            records.append({"event":"journey", "name":label,"result":"failed", "error":str(exc),"trace":traceback.format_exc()})
+            print(label + ": " + str(exc), flush=True)
+    for slug in ["notebook", "sources", ""]:
+        page.goto(BASE + "/" + slug)
+        capture(page,(slug or "home")+"-after-games")
+        page.screenshot(path=str(OUT / ((slug or "home")+"-full.png")),full_page=True)
+    ctx.storage_state(path=str(OUT / "completed-storage.json"))
+    (OUT / "observations.json").write_text(json.dumps(records, indent=2), encoding="utf-8")
+    browser.close()
