              src="/art/v2/hero.webp"
              alt=""
              fill
              priority
              sizes="(min-width: 1024px) 480px, 100vw"
              className="object-contain mix-blend-multiply"
            />
          </div>
        </section>

        <LadderEnd />

        <section id="path" className="mt-12 scroll-mt-4" aria-labelledby="path-title">
          <h2 id="path-title" className="font-heading text-[30px] font-medium">
            The path, early to late
          </h2>
          <p className="mt-1 max-w-prose text-[17px] text-muted-foreground">
            Start at 1 or anywhere you like. The early Wittgenstein comes first; the later one questions him.
          </p>
          <ol className="relative mt-6 grid gap-3 sm:grid-cols-2 lg:grid-cols-7 lg:gap-4 lg:before:absolute lg:before:top-[7px] lg:before:right-[7%] lg:before:left-[7%] lg:before:h-px lg:before:bg-vermilion/50">
            {GAMES.map((g) => (
              <li key={g.slug} className="relative">
                <Link
                  href={`/play/${g.slug}`}
                  className="group flex h-full gap-3 rounded-lg border border-border bg-card p-3 transition-colors hover:border-ink/40 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ink lg:flex-col lg:border-0 lg:bg-transparent lg:p-0"
                >
                  <span
                    className="hidden size-3.5 self-center rounded-full border-2 border-paper bg-vermilion ring-1 ring-vermilion lg:block"
                    aria-hidden
                  />
                  <span className="relative block size-24 shrink-0 overflow-hidden rounded-md bg-paper-deep lg:order-2 lg:aspect-square lg:size-auto lg:bg-transparent">
                    <Image
                      src={`/art/v2/stop-${g.step}.webp`}
                      alt=""
                      fill
                      sizes="(min-width: 1024px) 150px, 96px"
                      className="object-contain mix-blend-multiply transition-transform group-hover:scale-[1.03]"
                    />
                  </span>
                  <span className="flex min-w-0 flex-1 flex-col gap-1 lg:order-1 lg:min-h-[132px] lg:text-center">
                    <span className="font-heading text-[15px] text-vermilion">{g.step}</span>
                    <span className="font-heading text-[21px] leading-tight font-medium">{g.title}</span>
                    <span className="text-[13px] text-muted-foreground italic">{g.work}</span>
                  </span>
                  <span className="hidden text-[15px] leading-snug lg:order-3 lg:block">{g.idea}</span>
                  <span className="mt-auto hidden items-center justify-between lg:order-4 lg:flex">
                    <ArrowRight className="size-5 text-ink transition-transform group-hover:translate-x-1" aria-hidden />
                    <GameProgress rounds={g.rounds} />
                  </span>
