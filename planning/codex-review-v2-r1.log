+"""Capture the live accuracy and feedback findings through visible controls."""
+import json
+import re
+from pathlib import Path
+from playwright.sync_api import sync_playwright
+
+out = Path(__file__).resolve().parent / "runtime-findings"
+out.mkdir(exist_ok=True)
+with sync_playwright() as p:
+    browser = p.chromium.launch()
+    ctx = browser.new_context(viewport={"width":390,"height":844},is_mobile=True,has_touch=True)
+    page = ctx.new_page()
+    page.goto("http://localhost:3417/play/hinges")
+    for answer in ["Look at the sign, phone them, or ask a neighbour.",
+                   "Nothing would be surer than this: any test would be less certain than what it tested.",
+                   re.compile("It isn't something I found out")]:
+        page.get_by_role("button",name=answer,exact=not isinstance(answer,re.Pattern)).tap()
+        page.get_by_role("button",name="Next",exact=True).tap()
+    page.get_by_role("button",name="As far as she likes: doubting is free.",exact=True).tap()
+    page.get_by_role("status").scroll_into_view_if_needed()
+    page.screenshot(path=str(out / "hinges-h1-4-wrong.png"))
+    data = {"hinges_feedback":page.get_by_role("status").inner_text()}
+    page.goto("http://localhost:3417/play/beetle")
+    page.get_by_role("button",name="Yes: put the boxes side by side and compare.",exact=True).tap()
+    data["beetle_feedback_box"] = page.get_by_role("status").bounding_box()
+    data["beetle_scroll_y"] = page.evaluate("scrollY")
+    page.screenshot(path=str(out / "beetle-bb1-1-wrong.png"))
+    data["beetle_feedback"] = page.get_by_role("status").inner_text()
+    (out / "findings.json").write_text(json.dumps(data,indent=2),encoding="utf-8")
+    print(json.dumps(data))
+    browser.close()

