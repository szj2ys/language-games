+"""Exercise wrong attempts, reloads and phone end-card placement."""
+import json
+import re
+from pathlib import Path
+from playwright.sync_api import sync_playwright
+
+ROOT = Path(__file__).resolve().parents[2]
+OUT = ROOT / "qa/codex-review-r1/phone-edges"
+OUT.mkdir(parents=True, exist_ok=True)
+BASE = "http://localhost:3417"
+results = []
+
+with sync_playwright() as p:
+    browser = p.chromium.launch()
+    ctx = browser.new_context(viewport={"width":390,"height":844}, is_mobile=True, has_touch=True)
+    page = ctx.new_page()
+    for slug in ["builder","scene","cafe","pupil","family","beetle","hinges"]:
+        page.goto(BASE + "/play/" + slug)
+        page.wait_for_timeout(350)
+        if slug == "builder":
+            page.get_by_role("button", name="pillar", exact=True).tap()
+        elif slug == "scene":
+            page.get_by_role("button", name="key", exact=True).tap()
+            page.get_by_role("button", name="Front row, place 1 from the left").tap()
+            page.get_by_role("button", name="Is it true?", exact=True).tap()
+        elif slug == "cafe":
+            page.get_by_role("button", name="“Yes, it's November.”", exact=True).tap()
+        elif slug == "pupil":
+            page.get_by_role("button", name="Explain: “Use “an” before a vowel.”", exact=True).tap()
+            page.get_by_role("button", name="an egg", exact=True).tap()
+        elif slug == "family":
+            page.get_by_role("radio", name="All", exact=True).tap()
+            page.get_by_role("button", name="Look", exact=True).tap()
+        elif slug == "beetle":
+            page.get_by_role("button", name="Yes: put the boxes side by side and compare.", exact=True).tap()
+        elif slug == "hinges":
+            page.get_by_role("button", name="Nothing could ever settle it.", exact=True).tap()
+        page.wait_for_timeout(250)
+        before = page.locator("body").inner_text()
+        page.screenshot(path=str(OUT / (slug+"-before-reload.png")))
+        page.reload()
+        page.wait_for_timeout(450)
+        after = page.locator("body").inner_text()
+        page.screenshot(path=str(OUT / (slug+"-after-reload.png")))
+        results.append({"slug":slug,"before":before,"after":after,"same_text":before==after})
+        (OUT / "reloads.json").write_text(json.dumps(results,indent=2),encoding="utf-8")
+        print(slug, before==after, flush=True)
+    browser.close()
