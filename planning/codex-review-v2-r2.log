+import json, hashlib, re
+from pathlib import Path
+from playwright.sync_api import sync_playwright
+
+ROOT = Path(__file__).resolve().parents[2]
+OUT = Path(__file__).resolve().parent
+BASE = 'http://localhost:3417'
+ROUTES = ['/', '/play/scene', '/play/builder', '/play/cafe', '/play/family', '/play/pupil', '/play/beetle', '/play/hinges', '/sources', '/notebook']
+
+def manifest():
+    return {str(p.relative_to(ROOT)).replace('\\','/'):hashlib.sha256(p.read_bytes()).hexdigest() for d in ['src','public','e2e','art'] for p in (ROOT/d).rglob('*') if p.is_file()}
+
+def run():
+    (OUT/'protected-baseline.json').write_text(json.dumps(manifest(),indent=2),encoding='utf8')
+    results=[]
+    with sync_playwright() as pw:
+        browser=pw.chromium.launch()
+        for device,vp,touch in [('phone',{'width':390,'height':844},True),('desktop',{'width':1440,'height':900},False)]:
+            folder=OUT/'root'/device
+            folder.mkdir(parents=True,exist_ok=True)
+            context=browser.new_context(viewport=vp,is_mobile=touch,has_touch=touch)
+            page=context.new_page()
+            errors=[]
+            page.on('pageerror',lambda e:errors.append(str(e)))
+            for route in ROUTES:
+                response=page.goto(BASE+route,wait_until='networkidle')
+                page.add_script_tag(path=str(ROOT/'node_modules/axe-core/axe.min.js'))
+                violations=page.evaluate("async()=> (await axe.run(document,{resultTypes:['violations']})).violations")
+                metrics=page.evaluate("""()=>({width:innerWidth,scroll:document.documentElement.scrollWidth,images:[...document.images].map(i=>({src:i.currentSrc,alt:i.alt,complete:i.complete,width:i.naturalWidth})),small:[...document.querySelectorAll('button,a,input,[role=radio],summary')].filter(e=>{let r=e.getBoundingClientRect();return r.width&&r.height&&(r.width<24||r.height<24)}).map(e=>({text:e.innerText,aria:e.getAttribute('aria-label'),rect:e.getBoundingClientRect().toJSON()})),links:[...document.querySelectorAll('a')].map(e=>({text:e.innerText,href:e.getAttribute('href')}))})""")
+                name=route.strip('/').replace('/','-') or 'home'
+                page.screenshot(path=str(folder/(name+'.png')),full_page=True)
+                page.screenshot(path=str(folder/(name+'-viewport.png')))
+                results.append({'device':device,'route':route,'status':response.status,'body':page.locator('body').inner_text(),'axe':violations,'metrics':metrics,'errors':errors.copy()})
+                print(device,route,'HTTP',response.status,'axe',[(v['id'],v['impact'],len(v['nodes'])) for v in violations],'overflow',metrics['scroll']>metrics['width'],flush=True)
+            context.close()
+        browser.close()
+    (OUT/'root'/'audit.json').write_text(json.dumps(results,indent=2),encoding='utf8')
+
+if __name__=='__main__': run()
