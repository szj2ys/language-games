+import json, re, hashlib, subprocess
+from pathlib import Path
+from root_audit import manifest
+
+ROOT=Path(__file__).resolve().parents[2]
+OUT=Path(__file__).resolve().parent
+report=ROOT/'planning/codex-review-v2-r2.md'
+body=report.read_text(encoding='utf8')
+before=json.loads((OUT/'protected-baseline.json').read_text(encoding='utf8'))
+after=manifest()
+changed=[p for p in before.keys()|after.keys() if before.get(p)!=after.get(p)]
+generated_cache=[p for p in changed if p=='e2e/__pycache__/play_all.cpython-310.pyc']
+authored_changes=[p for p in changed if p not in generated_cache]
+assert not authored_changes, authored_changes
+assert body.splitlines()[0]=='VERDICT: NOT SATISFIED'
+assert body.rstrip().splitlines()[-1].startswith('Not covered:')
+assert len(re.findall(r'^\| R\d+:',body,re.M))==14
+assert len(re.findall(r'^\*\*R2-\d+ — major',body,re.M))==3
+assert len(re.findall(r'^\*\*R2-\d+ — minor',body,re.M))==3
+
+def records(path):
+    d=json.loads(path.read_text(encoding='utf8'))
+    o=next(x for x in d['origins'] if x['origin']=='http://localhost:3417')
+    return json.loads(next(x['value'] for x in o['localStorage'] if x['name']=='language-games:v1'))['rounds']
+
+counts={}
+for device in ['phone','desktop']:
+    a=records(OUT/'early-games'/device/'storage.json')
+    b=records(OUT/'late-games'/device/'storage.json')
+    assert len(a)==91 and len(b)==20 and len(a.keys()|b.keys())==111
+    counts[device]={'early':len(a),'late':len(b),'total':len(a.keys()|b.keys())}
+coverage=json.loads((OUT/'philosophy/coverage.json').read_text(encoding='utf8'))
+assert (coverage['source_count'],coverage['session_count'],coverage['round_count'])==(45,22,111)
+paths=set(re.findall(r'`(qa/codex-review-r2/[^`]+)`',body))
+missing=[p for p in paths if p!='qa/codex-review-r2/integrity.json' and not (ROOT/p).exists()]
+assert not missing,missing
+audit=json.loads((OUT/'root/audit.json').read_text(encoding='utf8'))
+bad_images=[(x['device'],x['route'],i['src']) for x in audit for i in x['metrics']['images'] if i['complete'] and i['width']==0]
+assert not bad_images,bad_images
+result={'head':subprocess.check_output(['git','rev-parse','HEAD'],cwd=ROOT,text=True).strip(),'protected_file_count':len(after),'protected_authored_changes':authored_changes,'incidental_generated_cache_changes':{p:{'before':before.get(p),'after':after.get(p)} for p in generated_cache},'gameplay_records':counts,'philosophy_counts':{'quotes':45,'sessions':22,'rounds':111},'initial_axe_scans':len(audit),'initial_axe_violations':sum(len(x['axe']) for x in audit),'broken_loaded_images':bad_images,'report_explicit_evidence_paths_checked':len(paths),'report_sha256':hashlib.sha256(report.read_bytes()).hexdigest(),'report_structure':'checked first line, all 14 prior IDs, 3 major + 3 minor findings, final Not covered line','limits':'Structural checks do not independently validate the written judgments.'}
+(OUT/'integrity.json').write_text(json.dumps(result,indent=2),encoding='utf8')
+print(json.dumps(result,indent=2))

