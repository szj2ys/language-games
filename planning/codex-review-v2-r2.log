            violations=page.evaluate("async()=> (await axe.run(document,{resultTypes:['violations']})).violations")
            metrics=page.evaluate("""()=>({width:innerWidth,scroll:document.documentElement.scrollWidth, images:[...document.images].map(i=>({src:i.currentSrc,alt:i.alt,complete:i.complete,width:i.naturalWidth})),small:[...document.querySelectorAll('button,a,input,[role=radio],summary')].filter(e=>{let r=e.getBoundingClientRect();return r.width&&r.height&&(r.width<24||r.height<24)}).map(e=>({text:e.innerText,aria:e.getAttribute('aria-label'),rect:e.getBoundingClientRect().toJSON()}))})""")
            name=device+route.replace('/','-')
            page.screenshot(path=str(OUT/(name+'.png')),full_page=True)
            results.append({'device':device,'route':route,'axe':violations,'metrics':metrics,'errors':errors})
            print(device,route,[(v['id'],v['impact'],len(v['nodes'])) for v in violations], 'overflow',metrics['scroll']>metrics['width'],flush=True)
        context.close()
    browser.close()
(OUT/'audit.json').write_text(json.dumps(results,indent=2),encoding='utf8')

