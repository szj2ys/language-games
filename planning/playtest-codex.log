@@ -0,0 +1,98 @@
+from pathlib import Path
+import json, re, traceback
+from playwright.sync_api import sync_playwright, expect
+
+OUT=Path(__file__).parent/'builder'
+OUT.mkdir(exist_ok=True)
+LOG=[]
+SHAPES={'block':'A solid cube of stone','pillar':'A tall round stone','slab':'A broad flat stone','beam':'A long narrow stone'}
+USE=['Bring him three slabs.','Write “3 slabs” on the stock list.','Answer: “No — it\'s a beam.”','Jump out of the way.','Ask: “Which one — the big one or the small one?”','Write “2 beams” on the stock list.']
+WRONG=['Write “3 slabs” on the stock list.','Carry three slabs to her.','Go and fetch him a slab.','Bring him a slab.','Bring the big one.','Bring her two beams.']
+
+with sync_playwright() as pw:
+    browser=pw.chromium.launch(headless=True)
+    for device,width,height in [('phone',390,844),('desktop',1440,900)]:
+        context=browser.new_context(viewport={'width':width,'height':height},is_mobile=device=='phone',has_touch=device=='phone')
+        page=context.new_page()
+        page.set_default_timeout(6000)
+        page.on('pageerror',lambda e: LOG.append({'device':device,'error':str(e)}))
+        def act(loc):
+            loc.scroll_into_view_if_needed()
+            loc.tap() if device=='phone' else loc.click()
+        def btn(name,exact=True):
+            return page.get_by_role('button',name=name,exact=exact)
+        def shot(tag):
+            path=OUT/f'{device}-{tag}.png'
+            page.screenshot(path=str(path),full_page=True)
+            text=page.locator('body').inner_text()
+            LOG.append({'device':device,'step':tag,'url':page.url,'text':text,'screenshot':str(path.relative_to(Path.cwd())) if path.is_absolute() else str(path)})
+            (OUT/'builder-log.json').write_text(json.dumps(LOG,ensure_ascii=False,indent=2),encoding='utf-8')
+        def pick_session(n,title):
+            act(btn(re.compile(re.escape(title))).first)
+            page.wait_for_timeout(250)
+            shot(f's{n}-picker')
+        def stone(s):
+            loc=btn(s)
+            if not loc.count(): loc=btn(SHAPES[s])
+            return loc
+        def say(*words):
+            bank=page.get_by_role('group',name='Words you can use')
+            for word in words: act(bank.get_by_role('button',name=word,exact=True))
+        try:
+            page.goto('http://localhost:3417/play/builder')
+            expect(page.get_by_role('heading',name='Slab!',exact=True)).to_be_visible()
+            pick_session(1,'Four words')
+            # A wrong stone, reload its feedback, then repair.
+            act(stone('block')); shot('s1-r1-wrong')
+            page.reload(); shot('s1-r1-reload')
+            if btn('Try again').count(): act(btn('Try again'))
+            for i,s in enumerate(['slab','pillar','beam','block','slab','beam'],1):
+                act(stone(s)); shot(f's1-r{i}-correct')
+                page.wait_for_timeout(1700)
+            expect(page.get_by_role('heading',name=re.compile('Done.*Four words'))).to_be_visible(); shot('s1-done')
+            pick_session(2,'Two slabs — there!')
+            for i,(s,n,place) in enumerate([('slab',2,'Here'),('pillar',1,'Left'),('block',3,'Here'),('beam',2,'Right'),('slab',3,'Left'),('pillar',2,'Right')],1):
+                act(stone(s))
+                if i==1:
+                    act(btn(re.compile('^Bring'))); shot('s2-r1-wrong-count')
+                    act(btn('Try again'))
+                for _ in range(n-1): act(btn('One more'))
+                act(page.get_by_role('radio',name=place,exact=True))
+                if i==3:
+                    shot('s2-r3-before-reload'); page.reload(); shot('s2-r3-after-reload')
+                act(btn(re.compile('^Bring'))); shot(f's2-r{i}-correct')
+                page.wait_for_timeout(1700)
+            expect(page.get_by_role('heading',name=re.compile('Done.*Two slabs'))).to_be_visible(); shot('s2-done')
+            pick_session(3,'Your turn to call')
+            calls=[(['pillar'],None),(['two','pillar','there'],'left'),(['one','beam','there'],'left'),(['three','slabs','there'],'right'),(['this'],'curved'),(['arch','there'],'right')]
+            for i,(words,point) in enumerate(calls,1):
+                if i==1:
+                    say('block'); act(btn(re.compile('^Call'))); shot('s3-r1-wrong')
+                    act(btn('Take it back')); act(btn('Remove block'))
+                say(*words)
+                if point=='curved': act(btn('Point at the curved stone'))
+                elif point: act(btn(f'Point at the {point} platform'))
+                if i==3:
+                    shot('s3-r3-before-reload'); page.reload(); shot('s3-r3-after-reload')
+                act(btn(re.compile('^Call'))); shot(f's3-r{i}-correct')
+                act(btn('Next'))
+            expect(page.get_by_role('heading',name=re.compile('Done.*Your turn'))).to_be_visible(); shot('s3-done')
+            pick_session(4,'Order or report?')
+            for i,(wrong,right) in enumerate(zip(WRONG,USE),1):
+                shot(f's4-r{i}-prompt')
+                act(btn(re.compile(re.escape(wrong))))
+                shot(f's4-r{i}-wrong')
+                if i==3:
+                    page.reload(); shot('s4-r3-reload')
+                act(btn(re.compile(re.escape(right))))
+                shot(f's4-r{i}-correct'); act(btn('Next'))
+            expect(page.get_by_role('heading',name=re.compile('Done.*Order or report'))).to_be_visible(); shot('s4-done')
+            page.goto('http://localhost:3417/notebook'); shot('notebook-completed')
+            LOG.append({'device':device,'completed':'4 sessions / 24 rounds'})
+        except Exception as e:
+            shot('ERROR'); print(device,type(e).__name__,str(e)[:1100]); traceback.print_exc(limit=1)
+        finally:
+            (OUT/'builder-log.json').write_text(json.dumps(LOG,ensure_ascii=False,indent=2),encoding='utf-8')
+            context.close()
+    browser.close()
+print('Completed', [x for x in LOG if 'completed' in x])

