export function findRound(id: string): BuilderRound | undefined {
  for (const s of SESSIONS) for (const r of s.rounds) if (r.id === id) return r;
}
// ---------------------------------------------------------------------------
// Same words, different jobs: order, report, question, warning (PI §§21, 27).

function UsePlay({
  round,
  speak,
  onDone,
  onNext,
}: {
  round: UseRound;
  speak: (t: string) => void;
  onDone: (firstTry: boolean, missed?: string) => void;
  onNext: () => void;
}) {
  const [chosen, setChosen] = useDraft<number | null>(round.id, "chosen", null);
  const [misses, setMisses] = useDraft(round.id, "misses", 0);
  const [firstMiss, setFirstMiss] = useDraft<string | null>(round.id, "firstMiss", null);
  const pick = chosen === null ? null : round.options[chosen];
  const solved = !!pick?.fits;

  useEffect(() => {
    const t = setTimeout(() => speak(round.says), 400);
    return () => clearTimeout(t);
  }, [round.says, speak]);

  const choose = (i: number) => {
    const o = round.options[i];
    setChosen(i);
    speak(o.reaction);
    if (o.fits) onDone(misses === 0, firstMiss ?? undefined);
    else {
      setMisses((m) => m + 1);
      if (!firstMiss) setFirstMiss(o.text);
      track("repair_used", { game: GAME, round: round.id });
    }
  };
  useShortcuts({
    "1": solved ? undefined : () => choose(0),
    "2": solved ? undefined : () => choose(1),
    "3": solved ? undefined : () => choose(2),
    Enter: solved ? onNext : undefined,
  });

  const keeper = round.speaker === "keeper";
  return (
    <div className="flex flex-1 flex-col gap-3 lg:grid lg:grid-cols-[minmax(0,1fr)_400px] lg:items-center lg:gap-8 lg:px-4">
      <div className="flex flex-1 flex-col lg:block">
        {/* Each situation is drawn (gpt-image-2): the beam in her arms, the sliding slab, the pile being counted. */}
        <SceneCanvas
          label={round.clues.join(" ")}
          overlay={
            <div className="absolute top-[4%] left-[3%] max-w-[62%] rounded-2xl border border-ink/15 bg-card px-3 py-1.5 shadow-sm">
              <p className="text-xs font-bold text-muted-foreground">{keeper ? "The stock-keeper" : "The builder"}</p>
              <p className="flex items-center gap-1 font-heading text-[clamp(17px,4.6vw,26px)] leading-tight font-semibold" aria-live="polite">
                {pick ? pick.reaction : round.says}
                <button
                  type="button"
                  onClick={() => speak(pick ? pick.reaction : round.says)}
                  aria-label="Hear it again"
                  className="-my-2 grid size-11 shrink-0 place-items-center rounded-full hover:bg-paper-deep"
                >
                  <Volume2 className="size-5" aria-hidden />
                </button>
              </p>
            </div>
          }
        >
          <Image src={`/art/builder/use/${round.id}.webp`} alt="" fill priority sizes="(min-width: 1024px) 700px, 133vw" className="object-cover" />
        </SceneCanvas>
        <ul className="flex flex-col gap-1 px-3 pt-2 lg:px-0" aria-label="What you can see">
          {round.clues.map((c) => (
            <li key={c} className="flex items-start gap-2 text-[15px] lg:text-[18px]">
              <Eye className="mt-0.5 size-4 shrink-0 text-cobalt" aria-hidden />
              {c}
            </li>
          ))}
        </ul>
      </div>
      <div className="mt-auto flex flex-col gap-2 px-3 pb-4 lg:mt-0 lg:px-0">
        {!solved ? (
          <>
            <p className="text-[15px] text-muted-foreground lg:text-[18px]">
              {keeper ? "The stock-keeper" : "The builder"} says “{round.says}” What do you do?
            </p>
            {round.options.map((o, i) => {
              const tried = chosen === i && !o.fits;
              return (
                <button
                  key={o.text}
                  type="button"
                  onClick={() => choose(i)}
                  disabled={tried}
                  data-shortcut=""
                  className={cn(
                    "flex min-h-14 items-center rounded-xl border-2 bg-card px-3 py-2 text-left text-[17px] hover:border-ink/30",
                    tried ? "border-terracotta/40 opacity-60" : "border-border",
                  )}
                >
                  <kbd
                    className="pointer-coarse:hidden mr-1 rounded bg-paper-deep px-1.5 text-xs font-bold text-muted-foreground"
                    aria-hidden
                  >
                    {i + 1}
                  </kbd>
                  {o.text}
                </button>
              );
            })}
          </>
        ) : (
          <>
            <div role="status" className="flex flex-col gap-2 rounded-xl bg-sage/15 p-4">
              <p className="text-sm font-bold text-sage">What the words were doing here</p>
              <p className="font-heading text-[20px] leading-snug">{round.use.charAt(0).toUpperCase() + round.use.slice(1)}.</p>
              <p className="text-[15px] lg:text-[18px] leading-relaxed">{round.note}</p>
            </div>
            <Button size="lg" className="h-12 text-lg" onClick={onNext} autoFocus>
              Next
            </Button>
          </>
        )}
      </div>
    </div>
  );
}
"use client";

import Image, { getImageProps } from "next/image";
import Link from "next/link";
import { ArrowLeft, Check, Lightbulb, Volume2, VolumeX } from "lucide-react";
import { useEffect, useRef } from "react";
import { ShortcutTip } from "./shortcuts";
import { SOURCES, WORK_TITLE, type Source, type SourceId } from "@/content/sources";
import { cn } from "@/lib/utils";
import { Button, buttonVariants } from "@/components/ui/button";

export function GameHeader({
  game,
  title,
  round,
  total,
  speech,
  onToggleSpeech,
}: {
  /** The game's name: the page's one H1. */
  game: string;
  /** The current session or level. */
  title: string;
  round: number;
  total: number;
  speech?: boolean;
  onToggleSpeech?: () => void;
}) {
  return (
    <header className="flex items-center gap-2 px-3 pt-2 pb-1 lg:px-4 lg:pt-4">
      <Link
        href="/"
        aria-label="All games"
        className="grid size-11 shrink-0 place-items-center rounded-full text-ink hover:bg-paper-deep focus-visible:outline-2 focus-visible:outline-cobalt"
      >
        <ArrowLeft className="size-5" aria-hidden />
      </Link>
      <div className="min-w-0 flex-1 leading-tight">
        <h1 className="truncate font-heading text-xl font-semibold lg:text-3xl">{game}</h1>
        <p className="truncate text-sm text-muted-foreground lg:text-lg">{title}</p>
      </div>
      <ol className="flex items-center gap-1.5" aria-label={`Round ${round + 1} of ${total}`}>
        {Array.from({ length: total }, (_, i) => (
          <li key={i} className={cn("size-2 rounded-full", i < round ? "bg-sage" : i === round ? "bg-cobalt" : "bg-border")} />
        ))}
      </ol>
      {onToggleSpeech && (
        <button
          type="button"
          onClick={onToggleSpeech}
          aria-pressed={speech}
          aria-label={speech ? "Turn voice off" : "Turn voice on"}
          className="grid size-11 shrink-0 place-items-center rounded-full hover:bg-paper-deep"
        >
          {speech ? <Volume2 className="size-5" aria-hidden /> : <VolumeX className="size-5" aria-hidden />}
        </button>
      )}
    </header>
  );
}

/** A remark in the margin: the passage, a plain gloss, and where the analogy stops. */
export function MarginNote({ id, className }: { id: SourceId; className?: string }) {
  const s: Source = SOURCES[id];
  return (
    <aside className={cn("rounded-xl border border-border bg-card p-4 text-left", className)}>
      <p className="font-heading text-sm text-terracotta">
        {WORK_TITLE[s.work]} <span className="font-semibold">{s.ref}</span>
      </p>
      <blockquote className="mt-2 font-heading text-[17px] leading-snug italic">“{s.quote}”</blockquote>
      <p className="mt-3 text-[15px] leading-relaxed">{s.gloss}</p>
      {s.limits && <p className="mt-2 text-sm text-muted-foreground">Where the game stops: {s.limits}</p>}
    </aside>
  );
}

export function SessionEnd({
  title,
  english,
  firstTry,
  total,
  items = [],
  art,
  sources,
  nextTitle,
  nextGame,
  onNext,
  onReplay,
}: {
  title: string;
  english: string;
  firstTry: number;
  total: number;
  /** Each round's English and the job it did: the lesson of the session. */
  items?: { text: string; did: string }[];
  /** The game's picture, so the finished screen still shows the world it happened in. */
  art?: string;
  sources: SourceId[];
  /** Absent on a game's last session. */
  nextTitle?: string;
  /** After a game's last session: the next game to play. */
  nextGame?: { title: string; href: string };
  onNext: () => void;
  onReplay: () => void;
}) {
  const [lead, ...more] = sources;
  return (
    <div className="mx-auto grid w-full max-w-6xl gap-5 px-4 py-5 lg:grid-cols-[minmax(0,1fr)_440px] lg:items-start lg:gap-8">
      {art && (
        <div className="relative aspect-[16/9] overflow-hidden rounded-2xl bg-paper-deep">
          <Image src={art} alt="" fill sizes="(min-width: 1024px) 700px, 100vw" className="object-cover" />
          <p className="absolute top-3 left-3 rounded-full bg-card px-3 py-1 font-heading text-lg font-semibold shadow-sm">
            {firstTry} of {total} right first time
          </p>
        </div>
      )}
      <div className="flex flex-col gap-4">
        <h2 className="font-heading text-3xl font-semibold">
          <span className="text-sage">Done</span> · {title}
        </h2>
        <p className="text-[17px] lg:text-[18px]">You practised {english.charAt(0).toLowerCase() + english.slice(1)}.</p>
        <div className="flex flex-col gap-2 sm:flex-row">
          {nextTitle ? (
            <Button size="lg" className="h-12 text-lg sm:flex-1" onClick={onNext} autoFocus>
              Next: {nextTitle}
            </Button>
          ) : (
            <Link href={nextGame?.href ?? "/"} className={cn(buttonVariants({ size: "lg" }), "h-12 text-lg sm:flex-1")}>
              {nextGame ? `Next game: ${nextGame.title}` : "Choose another game"}
            </Link>
          )}
          <Button size="lg" variant="outline" className="h-12" onClick={onReplay}>
            Play again
          </Button>
        </div>
        {items.length > 0 && (
          <section aria-label="Your English in this session">
            <ul className="flex flex-col divide-y divide-border rounded-xl border border-border bg-card">
              {items.map((x) => (
                <li key={x.text + x.did} className="flex flex-wrap items-baseline justify-between gap-x-3 px-3 py-2">
                  <span className="font-heading text-[17px] lg:text-[18px]">{x.text}</span>
                  <span className="text-[14px] text-muted-foreground lg:text-[15px]">{x.did}</span>
                </li>
              ))}
            </ul>

