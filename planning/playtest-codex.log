+++ b/qa/playtest-codex/builder_probe.py
@@ -0,0 +1,22 @@
+from pathlib import Path
+import json
+from playwright.sync_api import sync_playwright
+
+OUT = Path(__file__).parent / 'builder'
+OUT.mkdir(exist_ok=True)
+with sync_playwright() as p:
+    browser = p.chromium.launch(headless=True)
+    for device, width, height in [('phone',390,844),('desktop',1440,900)]:
+        context = browser.new_context(viewport={'width':width,'height':height}, is_mobile=device=='phone', has_touch=device=='phone')
+        page = context.new_page()
+        for route in ['/', '/play/builder', '/sources', '/notebook']:
+            page.goto('http://localhost:3417'+route)
+            page.wait_for_timeout(700)
+            tag = route.replace('/','-').strip('-') or 'home'
+            page.screenshot(path=str(OUT/f'{device}-{tag}-initial.png'),full_page=True)
+            (OUT/f'{device}-{tag}-initial.txt').write_text(page.locator('body').inner_text(),encoding='utf-8')
+            if route=='/play/builder':
+                print(device, page.locator('body').inner_text())
+                print(page.get_by_role('button').all_text_contents())
+        context.close()
+    browser.close()
