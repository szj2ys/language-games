def shot(page: Page, name: str) -> None:
    global step
    step += 1
    page.screenshot(path=str(SHOTS / f"{step:03d}-{name}.png"))


def tap(page: Page, role: str, name: str, exact: bool = True) -> None:
    page.get_by_role(role, name=name, exact=exact).first.click()


