+from pathlib import Path
+import json
+from playwright.sync_api import sync_playwright
+out=Path(__file__).parent/'builder'
+with sync_playwright() as p:
+    browser=p.chromium.launch(headless=True)
+    for device,w,h in [('phone',390,844),('desktop',1440,900)]:
+        c=browser.new_context(viewport={'width':w,'height':h},is_mobile=device=='phone',has_touch=device=='phone')
+        q=c.new_page();q.goto('http://localhost:3417/play/builder')
+        def press(name):
+            b=q.get_by_role('button',name=name,exact=True);b.scroll_into_view_if_needed()
+            b.tap() if device=='phone' else b.click()
+        press('block');press('Try again');press('slab');q.wait_for_timeout(600)
+        q.screenshot(path=str(out/f'{device}-selection-recheck.png'),full_page=True)
+        press('Your turn to call');q.wait_for_timeout(400);press('pillar');press('Call: “Pillar!”')
+        q.wait_for_timeout(1800)
+        q.screenshot(path=str(out/f'{device}-delivered-pillar-recheck.png'),full_page=True)
+        (out/f'{device}-recheck.txt').write_text(q.locator('body').inner_text(),encoding='utf-8')
