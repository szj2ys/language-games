import importlib.util, json, re, sys, traceback
sys.dont_write_bytecode=True
from pathlib import Path
from playwright.sync_api import sync_playwright, expect

ROOT=Path(__file__).resolve().parents[3]
OUT=ROOT/'qa/codex-review-r5/late-games'
sys.argv += ['--shots',str(OUT/'helper-shots')]
spec=importlib.util.spec_from_file_location('journey',ROOT/'e2e/play_all.py')
j=importlib.util.module_from_spec(spec); spec.loader.exec_module(j)
records=[]; folder=OUT; count=0

def shot(page,name):
    global count
    count+=1
    page.wait_for_timeout(200)
    for _ in range(30):
        if page.evaluate('() => [...document.images].every(i=>i.complete)'): break
        page.wait_for_timeout(100)
    path=folder/f'{count:03}-{name}.png'
    page.screenshot(path=str(path))
    records.append({'name':name,'device':folder.name,'url':page.url,'shot':str(path.relative_to(ROOT)),'text':page.locator('body').inner_text(),'y':page.evaluate('scrollY'),'overflow':page.evaluate('document.documentElement.scrollWidth-innerWidth')})
    (OUT/'observations.json').write_text(json.dumps(records,indent=2),encoding='utf8')

j.shot=shot
orig_next=j.next_round
def nxt(page):
    shot(page,'solved')
    orig_next(page)
    shot(page,'next')
j.next_round=nxt
orig_pick=j.pick_session
def pick(page,title):
    orig_pick(page,title)
    shot(page,'session-'+re.sub('[^a-z0-9]+','-',title.lower()))
j.pick_session=pick

def answer(page,title):
    while page.get_by_text(re.compile(r'Done · ')).count()==0:
        if page.get_by_role('button',name='Next',exact=True).count():
            nxt(page); continue
        answers=page.get_by_role('group',name='Answers').get_by_role('button')
        next(b for b in answers.all() if b.is_enabled()).click()
        shot(page,'question-answer')
    shot(page,'end-'+re.sub('[^a-z0-9]+','-',title.lower()))
j.answer_questions=answer

with sync_playwright() as p:
    browser=p.chromium.launch()
    for device in ['phone','desktop']:
        folder=OUT/device; folder.mkdir(parents=True,exist_ok=True); count=0
        ctx=browser.new_context(viewport={'width':390,'height':844} if device=='phone' else {'width':1440,'height':900},has_touch=device=='phone',is_mobile=device=='phone',device_scale_factor=1)
        page=ctx.new_page(); page.set_default_timeout(8000)
        page.on('pageerror',lambda e:records.append({'event':'pageerror','error':str(e)}))
        page.on('console',lambda m:records.append({'event':'console','error':m.text}) if m.type=='error' else None)
        for game in ['pupil','beetle','hinges']:
