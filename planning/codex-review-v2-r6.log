import json, re
from pathlib import Path
from playwright.sync_api import sync_playwright, expect
OUT = Path(__file__).resolve().parent
ROOT = OUT.parents[2]
records = []
with sync_playwright() as pw:
    browser = pw.chromium.launch()
    for device in ['phone', 'desktop']:
        old = json.loads((ROOT/f'qa/codex-review-r3/late-games/{device}/storage.json').read_text(encoding='utf8'))
        initial = json.loads(next(x['value'] for x in old['origins'][0]['localStorage'] if x['name']=='language-games:v1'))
        context = browser.new_context(viewport={'width':390,'height':844} if device=='phone' else {'width':1440,'height':900}, is_mobile=device=='phone', has_touch=device=='phone', storage_state=old)
        page = context.new_page()
        folder = OUT/(device+'-migration')
        def capture(name):
            page.screenshot(path=str(folder/(name+'.png')),full_page=True)
            records.append({'device':device,'name':name,'url':page.url,'text':page.locator('body').inner_text(),'storage':page.evaluate('()=>({...localStorage})')})
        page.goto('http://localhost:3417/',wait_until='networkidle')
        capture('home-before-continue')
        links=page.get_by_role('link').filter(has_text=re.compile('Continue'))
        records.append({'device':device,'continue_links':[{'text':l.inner_text(),'href':l.get_attribute('href')} for l in links.all()]})
        links.first.click()
        expect(page).to_have_url('http://localhost:3417/play/hinges')
        expect(page.get_by_text('Done · The river-bed')).to_be_visible()
        capture('home-continue-still-complete')
        after=json.loads(page.evaluate("localStorage.getItem('language-games:v1')"))
        assert all(after['rounds'][k]==v for k,v in initial['rounds'].items() if k!='h1-0')
        records.append({'device':device,'unrelated_progress_preserved':True,'new_activity_complete':'h1-checks' in after['rounds']})
        # Model an old h1-0 draft, retaining its ID while using valid completed check fields.
        page.evaluate("""() => { for (const [field,value] of Object.entries({path:['claim','eyes'],check:0,checked:{eyes:['words','others']},doubted:true,done:true})) localStorage.setItem('language-games:draft:h1-0:'+field,JSON.stringify(value)); }""")
        page.get_by_role('navigation',name='Sessions').get_by_role('button',name=re.compile('Doubt it')).click()
        expect(page.get_by_role('button',name='Read the sign on the bakery door.',exact=True)).to_be_visible()
        expect(page.get_by_role('button',name='Next',exact=True)).to_have_count(0)
        capture('old-draft-ignored')
        page.reload(wait_until='networkidle')
        expect(page.get_by_role('button',name='Read the sign on the bakery door.',exact=True)).to_be_visible()
        capture('old-draft-ignored-after-reload')
        context.close()
    browser.close()
(OUT/'migration-followup.json').write_text(json.dumps(records,indent=2),encoding='utf8')
