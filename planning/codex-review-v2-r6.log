},\"h1-0\":{\"marks\":2,\"max\":2,\"firstTry\":true,\"said\":[\"Stands fast: My eyes are working.\",\"Stands fast: Words like \u201ceight\u201d and \u201copen\u201d mean what I take them to mean.\"]},\"h1-3\":{\"marks\":1,\"max\":2,\"firstTry\":false,\"said\":[\"\u201cIt isn't something I found out. It's part of how I find things out.\u201d\"],\"missed\":\"\u201cI've looked at a great many trees.\u201d\"},\"h1-4\":{\"marks\":1,\"max\":2,\"firstTry\":false,\"said\":[\"Not far: doubting itself needs something certain.\"],\"missed\":\"As far as she likes: doubting is free.\"},\"h1-4b\":{\"marks\":2,\"max\":2,\"firstTry\":true,\"said\":[\"No: it is an ordinary question, settled by looking through telescopes.\"]},\"h1-5\":{\"marks\":1,\"max\":2,\"firstTry\":false,\"said\":[\"The things that stand fast, so that our questions can turn.\"],\"missed\":\"The things we have checked most carefully.\"},\"h2-0\":{\"marks\":2,\"max\":2,\"firstTry\":true,\"said\":[\"Sorted the river-bed in 1950 and 1970\"]},\"h2-1\":{\"marks\":2,\"max\":2,\"firstTry\":true,\"said\":[\"The questions we argue about and settle.\"]},\"h2-2\":{\"marks\":1,\"max\":2,\"firstTry\":false,\"said\":[\"No: it came with the picture of the world I was given, the background I check things against.\"],\"missed\":\"Yes: I weighed the evidence first.\"},\"h2-5\":{\"marks\":1,\"max\":2,\"firstTry\":false,\"said\":[\"No: if everything were up for checking, nothing could be checked.\"],\"missed\":\"Yes: we just haven't got round to checking them.\"}},\"phrases\":[\"Showed after 2: 4\",\"Showed after 50: 52\",\"Showed after 996: 998\",\"Showed after 10: 12\",\"Showed after 1,000: 1,002\",\"Your call: Correct it: 1002 is what \u201cadd 2\u201d means here.\",\"Showed 1st: 3\",\"Showed 2nd: 5\",\"Showed 3rd: 7\",\"Showed 4th: 9\",\"Your call: It's not a mistake: 3, 5, 7 begins both series.\",\"Showed 1st: 1\",\"Showed 2nd: 2\",\"Showed 3rd: 4\",\"Showed 6th: 32\",\"Your call: At some point say: \u201cThis is simply what we