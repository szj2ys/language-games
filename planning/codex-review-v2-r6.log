            shot(page,'pupil-taught-before-reload')
            page.reload(); shot(page,'pupil-taught-after-reload')
            page.get_by_role('button',name="Now a case it hasn't seen").click()
            shot(page,'pupil-twist')
            opts=page.get_by_role('group',name='Your call').get_by_role('button')
            if not opts.count(): opts=page.locator('button').filter(has_text='Correct it:')
            page.get_by_role('button',name=j.PUPIL_CALLS[0],exact=True).click(); nxt(page)
            for call in j.PUPIL_CALLS[1:]:
                j.show_cards_until_pass(page); shot(page,'pupil-taught')
                page.get_by_role('button',name="Now a case it hasn't seen").click(); shot(page,'pupil-twist')
