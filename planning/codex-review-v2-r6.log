+++ b/qa/codex-review-r6/verify.py
@@ -0,0 +1,184 @@
+"""R6: rerun R5's genuine returning-save journey against the existing server only."""
+import hashlib
+import json
+import re
+import subprocess
+import traceback
+from datetime import datetime, timezone
+from pathlib import Path
+
+from playwright.sync_api import expect, sync_playwright
+
+ROOT = Path(__file__).resolve().parents[2]
+OUT = Path(__file__).resolve().parent
+BASE = "http://localhost:3417"
+KEY = "language-games:v1"
+records = []
+errors = []
+
+
+def protected_hashes():
+    return {str(p.relative_to(ROOT)): hashlib.sha256(p.read_bytes()).hexdigest()
+            for name in ["src", "public", "e2e", "art"]
+            for p in (ROOT / name).rglob("*") if p.is_file()}
+
+
+def save(page):
+    return json.loads(page.evaluate("localStorage.getItem('language-games:v1')"))
+
+
+def capture(page, device, name):
+    page.evaluate("document.fonts.ready")
+    page.wait_for_function("[...document.images].every(i => i.complete)")
+    page.screenshot(path=str(OUT / device / (name + ".png")), full_page=True)
+    records.append({"device": device, "name": name, "url": page.url,
+                    "text": page.locator("body").inner_text(), "save": save(page),
+                    "viewport": page.viewport_size,
+                    "overflow": page.evaluate("document.documentElement.scrollWidth > innerWidth"),
+                    "broken_images": page.evaluate("[...document.images].filter(i => !i.naturalWidth).map(i => i.src)")})
+
+
+def act(page, name, phone):
+    locator = page.get_by_role("button", name=name, exact=isinstance(name, str))
+    (locator.tap if phone else locator.click)()
+
+
+def finish_doubt(page, phone):
+    act(page, "Read the sign on the bakery door.", phone)
+    act(page, re.compile(r"^My eyes are working.*Check this$"), phone)
+    act(page, "Read the letters on an optician's chart while she checks.", phone)
+    expect(page.get_by_text("can be checked, but only with other things standing fast")).to_be_visible()
+    act(page, "Doubt everything at once", phone)
+    expect(page.get_by_text("no check can start")).to_be_visible()
+    act(page, "Next", phone)
+    finish_questions(page, "Doubt it", phone)
+
+
+def finish_questions(page, title, phone):
+    for _ in range(30):
+        if page.get_by_text("Done · " + title, exact=True).count():
+            break
+        if page.get_by_role("button", name="Next", exact=True).count():
+            act(page, "Next", phone)
+        else:
+            choices = page.get_by_role("group", name="Answers").get_by_role("button")
+            choice = next(b for b in choices.all() if b.is_enabled())
+            (choice.tap if phone else choice.click)()
+    expect(page.get_by_text("Done · " + title, exact=True)).to_be_visible()
+
+
+def finish_river(page, phone):
+    nav = page.get_by_role("navigation", name="Sessions").get_by_role("button", name="The river-bed")
+    (nav.tap if phone else nav.click)()
+    beds = {"The bakery opens at eight on Saturdays.": [False, False],
+            "No one has ever been on the moon.": [True, False],
+            "The earth existed long before I was born.": [True, True],
+            "It will rain tomorrow.": [False, False], "I have two hands.": [True, True]}
+    for era, button in [(0, re.compile(r"^Check, then go to")), (1, "Done")]:
+        for text, bed in beds.items():
+            label = "Stands fast (the bed)" if bed[era] else "Open to checking (the water)"
+            control = page.get_by_role("group", name=text).get_by_role("button", name=label)
+            (control.tap if phone else control.click)()
+        act(page, button, phone)
+    act(page, "Next", phone)
+    finish_questions(page, "The river-bed", phone)
+
+
+baseline = protected_hashes()
+(OUT / "protected-baseline.json").write_text(json.dumps(baseline, indent=2), encoding="utf8")
+head = subprocess.check_output(["git", "rev-parse", "HEAD"], cwd=ROOT, text=True).strip()
+started = datetime.now(timezone.utc).isoformat()
+with sync_playwright() as pw:
+    browser = pw.chromium.launch()
+    for device in ["phone", "desktop"]:
+        phone = device == "phone"
+        (OUT / device).mkdir(exist_ok=True)
+        options = dict(viewport={"width": 390, "height": 844} if phone else {"width": 1440, "height": 900},
+                       is_mobile=phone, has_touch=phone, device_scale_factor=1)
+        fixture = ROOT / f"qa/codex-review-r3/late-games/{device}/storage.json"
+        old = json.loads(fixture.read_text(encoding="utf8"))
+        initial = json.loads(next(x["value"] for x in old["origins"][0]["localStorage"] if x["name"] == KEY))
+        assert initial["positions"]["hinges"] == {"session": 1, "round": 4}
+        assert "h1-0" in initial["rounds"] and "h1-checks" not in initial["rounds"]
+        records.append({"device": device, "fixture": str(fixture.relative_to(ROOT)),
+                        "fixture_sha256": hashlib.sha256(fixture.read_bytes()).hexdigest(),
+                        "initial_hinges_position": initial["positions"]["hinges"]})
+        for scenario in ["returning", "fresh-first", "fresh-later"]:
+            context = browser.new_context(**options, **({"storage_state": old} if scenario == "returning" else {}))
+            page = context.new_page()
+            page.set_default_timeout(8000)
+            page.on("pageerror", lambda e, d=device, s=scenario: errors.append({"device": d, "scenario": s, "error": str(e)}))
+            page.on("console", lambda m, d=device, s=scenario: errors.append({"device": d, "scenario": s, "console_error": m.text}) if m.type == "error" else None)
+            try:
+                if scenario == "returning":
+                    page.goto(BASE + "/", wait_until="networkidle")
+                    capture(page, device, "home-before-continue")
+                    link = page.get_by_role("link").filter(has_text=re.compile("Continue")).first
+                    (link.tap if phone else link.click)()
+                    expect(page).to_have_url(BASE + "/play/hinges")
+                    expect(page.get_by_role("button", name="Read the sign on the bakery door.", exact=True)).to_be_visible()
+                    expect(page.get_by_text("Done · The river-bed", exact=True)).to_have_count(0)
+                    expect(page.get_by_role("button", name="Next", exact=True)).to_have_count(0)
+                    after = save(page)
+                    assert after["positions"]["hinges"] == {"session": 0, "round": 0}
+                    assert "h1-checks" not in after["rounds"]
+                    assert all(after["rounds"][k] == v for k, v in initial["rounds"].items() if k != "h1-0")
+                    assert after["settings"] == initial["settings"]
+                    assert all(after["positions"][k] == v for k, v in initial["positions"].items() if k != "hinges")
+                    capture(page, device, "continue-to-doubt-it")
+                    print(device + ": genuine R5 returning-save reproduction FIXED; unrelated progress preserved", flush=True)
+                    page.evaluate("""() => { for (const [field,value] of Object.entries({path:['claim','eyes'],check:0,checked:{eyes:['words','others']},doubted:true,done:true})) localStorage.setItem('language-games:draft:h1-0:'+field,JSON.stringify(value)); }""")
+                    page.reload(wait_until="networkidle")
+                    expect(page.get_by_role("button", name="Read the sign on the bakery door.", exact=True)).to_be_visible()
+                    expect(page.get_by_role("button", name="Next", exact=True)).to_have_count(0)
+                    capture(page, device, "reload-old-draft-ignored")
+                    finish_doubt(page, phone)
+                    capture(page, device, "replacement-session-finished")
+                    assert "h1-checks" in save(page)["rounds"]
+                    page.reload(wait_until="networkidle")
+                    expect(page.get_by_text("Done · Doubt it", exact=True)).to_be_visible()
+                    capture(page, device, "replacement-finished-after-reload")
+                    finish_river(page, phone)
+                    page.reload(wait_until="networkidle")
+                    expect(page.get_by_text("Done · The river-bed", exact=True)).to_be_visible()
+                    capture(page, device, "all-complete-river-end-after-reload")
+                else:
+                    page.goto(BASE + "/play/hinges", wait_until="networkidle")
+                    if scenario == "fresh-first":
+                        finish_doubt(page, phone)
+                        end_title = "Doubt it"
+                        assert not any(k.startswith("h2-") for k in save(page)["rounds"])
+                    else:
+                        finish_river(page, phone)
+                        end_title = "The river-bed"
+                        assert "h1-checks" not in save(page)["rounds"]
+                    # Exercise the end card after the state update; a mount-only fix must not redirect it.
+                    more = page.locator("summary").filter(has_text="More from Wittgenstein")
+                    (more.tap if phone else more.click)()
+                    expect(page.get_by_text("Done · " + end_title, exact=True)).to_be_visible()
+                    capture(page, device, scenario + "-end-retained")
+                    page.reload(wait_until="networkidle")
+                    expect(page.get_by_text("Done · " + end_title, exact=True)).to_have_count(0)
+                    if scenario == "fresh-later":
+                        expect(page.get_by_role("button", name="Read the sign on the bakery door.", exact=True)).to_be_visible()
+                    else:
+                        expect(page.get_by_role("group", name="No one has ever been on the moon.")).to_be_visible()
+                    capture(page, device, scenario + "-arrival-finds-unplayed")
+                records.append({"device": device, "scenario": scenario, "passed": True})
+                print(device + ": " + scenario + " PASS", flush=True)
+            except Exception:
+                records.append({"device": device, "scenario": scenario, "passed": False, "failure": traceback.format_exc()})
+                capture(page, device, scenario + "-failure")
+                print(device + ": " + scenario + " FAIL", flush=True)
+            finally:
+                context.close()
+                (OUT / "results.json").write_text(json.dumps({"started_utc": started, "head": head, "url": BASE,
+                    "records": records, "errors": errors}, indent=2), encoding="utf8")
+    browser.close()
+unchanged = baseline == protected_hashes()
+assert unchanged, "Protected files changed during review"
+(OUT / "integrity.json").write_text(json.dumps({"protected_files_unchanged": unchanged, "file_count": len(baseline)}, indent=2), encoding="utf8")
+assert not errors, errors
+assert all(r.get("passed", True) for r in records), "A scenario failed; see results.json"
+assert all(not r.get("overflow") and not r.get("broken_images") for r in records), "Visual mechanical defect"
+print("PASS: six device/scenario journeys; no captured runtime errors, overflow or broken images; protected files unchanged.")

