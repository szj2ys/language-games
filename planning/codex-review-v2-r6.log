import json, re, sys
from pathlib import Path
sys.dont_write_bytecode=True
from playwright.sync_api import sync_playwright, expect
OUT=Path(__file__).resolve().parent
records=[]
with sync_playwright() as pw:
    browser=pw.chromium.launch()
    for device in ['phone','desktop']:
        ctx=browser.new_context(viewport={'width':390,'height':844} if device=='phone' else {'width':1440,'height':900},is_mobile=device=='phone',has_touch=device=='phone',storage_state=str(OUT/device/'storage.json'))
        page=ctx.new_page()
        page.goto('http://localhost:3417/play/pupil')
        expect(page.get_by_text('Done · Signposts')).to_be_visible()
        page.locator('summary').filter(has_text='More from Wittgenstein').click()
        page.screenshot(path=str(OUT/(device+'-edges')/'signposts-expanded.png'),full_page=True)
        records.append({'device':device,'name':'signposts-expanded','text':page.locator('body').inner_text()})
        for game,target in [('pupil','beetle'),('beetle','hinges'),('hinges','scene')]:
            page.goto('http://localhost:3417/play/'+game)
            page.get_by_role('link',name=re.compile('^Next idea:')).click()
            expect(page).to_have_url('http://localhost:3417/play/'+target)
            records.append({'device':device,'action':'next-idea','from':game,'to':target,'pass':True})
            page.goto('http://localhost:3417/play/'+game)
            page.get_by_role('button',name='Play again',exact=True).click()
            expect(page.get_by_text(re.compile('^Done · '))).to_have_count(0)
            page.screenshot(path=str(OUT/(device+'-edges')/(game+'-replayed.png')))
            records.append({'device':device,'action':'replay','game':game,'text':page.locator('body').inner_text()})
        ctx.close()
    browser.close()
(OUT/'end-checks.json').write_text(json.dumps(records,indent=2),encoding='utf8')
print('Both devices: all three final end-card next-idea/replay actions passed; Signposts passages expanded.')

