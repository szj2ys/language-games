commit 6be91173980a5639dd9d5d008ca4644308f5455e
Author: szj2ys <54836091+szj2ys@users.noreply.github.com>
Date:   Sun Nov 1 09:27:01 2026 +0800

    fix: returning players with a replaced round are sent to it, not to an old end card (Codex r5 residual)
    
    Co-Authored-By: Claude <noreply@anthropic.com>

diff --git a/src/components/game/use-sessions.ts b/src/components/game/use-sessions.ts
index 8f5232c..205e33f 100644
--- a/src/components/game/use-sessions.ts
+++ b/src/components/game/use-sessions.ts
@@ -1,7 +1,8 @@
 "use client";
 
 import { track } from "@/components/analytics";
-import { recordRound, resolvePosition } from "@/lib/progress";
+import { useEffect, useRef } from "react";
+import { recordRound, resolvePosition, resumeTarget } from "@/lib/progress";
 import { useSave, useSpeech } from "@/lib/use-save";
 import { clearDrafts } from "@/lib/use-draft";
 
@@ -16,6 +17,14 @@ export function useSessions<S extends SessionLike>(game: string, sessions: S[],
   // A saved place counts only if the rounds before it were played: content can change between visits.
   const { session: sessionIndex, round: roundIndex, finished } = resolvePosition(sessions, save.rounds, save.positions[game]);
   const session = sessions[sessionIndex];
+  // On arrival, leave a saved end card for any round still unplayed (content can be replaced between visits).
+  const arrived = useRef(false);
+  useEffect(() => {
+    if (!ready || arrived.current) return;
+    arrived.current = true;
+    const target = resumeTarget(sessions, save.rounds, save.positions[game]);
+    if (target) update((sv) => ({ ...sv, positions: { ...sv.positions, [game]: target } }));
+  }, [ready, sessions, save, game, update]);
   const round = session.rounds[roundIndex] as S["rounds"][number];
   const speech = useSpeech(save.settings.speech);
 
diff --git a/src/lib/__tests__/progress.test.ts b/src/lib/__tests__/progress.test.ts
index 2d2dffe..a705db9 100644
--- a/src/lib/__tests__/progress.test.ts
+++ b/src/lib/__tests__/progress.test.ts
@@ -1,5 +1,5 @@
 import { describe, expect, it } from "vitest";
-import { emptySave, mergeSaves, parseSave, recordRound, resetSave, resolvePosition, SAVE_VERSION } from "../progress";
+import { emptySave, mergeSaves, parseSave, recordRound, resetSave, resolvePosition, resumeTarget, SAVE_VERSION } from "../progress";
 import oldSave from "./old-save.fixture.json";
 import { SESSIONS as PUPIL } from "@/games/pupil/levels";
 import { SESSIONS as BEETLE } from "@/games/beetle/rounds";
@@ -71,4 +71,12 @@ describe("resuming after the content changed", () => {
   it("starts at the beginning with no save", () => {
     expect(resolvePosition(BUILDER, {}, undefined)).toEqual({ session: 0, round: 0, finished: false });
   });
+  it("on arrival, does not reopen an end card while a replaced round elsewhere is unplayed", () => {
+    const games = [{ rounds: [{ id: "new" }, { id: "b" }] }, { rounds: [{ id: "c" }] }];
+    // During play the end card of the session just finished still shows...
+    expect(resolvePosition(games, { b: {}, c: {} }, { session: 1, round: 1 }).finished).toBe(true);
+    // ...but a returning player is sent to the unplayed round.
+    expect(resumeTarget(games, { b: {}, c: {} }, { session: 1, round: 1 })).toEqual({ session: 0, round: 0 });
+    expect(resumeTarget(games, { new: {}, b: {}, c: {} }, { session: 1, round: 1 })).toBeNull();
+  });
 });
diff --git a/src/lib/progress.ts b/src/lib/progress.ts
index 5d923b7..9e14c64 100644
--- a/src/lib/progress.ts
+++ b/src/lib/progress.ts
@@ -182,3 +182,22 @@ export function resolvePosition(
   const last = sessions.length - 1;
   return { session: last, round: sessions[last].rounds.length - 1, finished: true };
 }
+
+/**
+ * On arrival only: a saved end card is no place to come back to while a round elsewhere in the game is
+ * unplayed (for example one replaced since the last visit). Returns where to go instead, or null.
+ * During play the end card of a session just finished is always shown.
+ */
+export function resumeTarget(
+  sessions: { rounds: { id: string }[] }[],
+  done: Record<string, unknown>,
+  pos: Position | undefined,
+): Position | null {
+  const here = resolvePosition(sessions, done, pos);
+  if (!here.finished) return null;
+  for (let i = 0; i < sessions.length; i++) {
+    const r = sessions[i].rounds.findIndex((x) => !done[x.id]);
+    if (r >= 0) return { session: i, round: r };
+  }
+  return null;
+}
