+    tap(page, 'Change it')
+    tap(page, 'Hint')
+    put(page, 'lamp', 'Front row, place 1 from the left', True)
+    page.reload()
+    tap(page, 'Is it true?')
+    record(page, 'scene-3-right-reload')
+    next_round(page)
+    put(page, 'cup', 'Front row, place 1 from the left')
+    tap(page, 'Is it true?')
+    record(page, 'scene-4-wrong')
+    tap(page, 'Change it')
+    tap(page, 'Hint')
+    put(page, 'cup', 'Put the cup on the box', True)
+    tap(page, 'Is it true?')
+    record(page, 'scene-4-on-box-right')
+    next_round(page)
+    put(page, 'box', 'Front row, place 3 from the left')
+    put(page, 'key', 'Put the key in the box')
+    put(page, 'ball', 'Put the ball on the book')
