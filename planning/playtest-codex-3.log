+import json
+import sys
+from pathlib import Path
+from playwright.sync_api import sync_playwright, expect
+
+OUT = Path(__file__).parent
+BASE = 'http://localhost:3418'
+records = []
+PHASE = sys.argv[1] if len(sys.argv) > 1 else 'scene'
+
+def record(page, label, shot=True):
+    page.evaluate('() => document.fonts.ready')
+    for _ in range(30):
+        if page.evaluate('() => [...document.images].every(i => i.complete)'):
+            break
+        page.wait_for_timeout(100)
+    if shot:
+        page.screenshot(path=str(OUT / f'phone-{label}.png'), full_page=True)
+    records.append({'label': label, 'url': page.url, 'text': page.locator('body').inner_text(),
+                    'overflow': page.evaluate('() => document.documentElement.scrollWidth > innerWidth')})
+    (OUT / f'phone-{PHASE}-evidence.json').write_text(json.dumps(records, indent=2, ensure_ascii=False), encoding='utf-8')
+    print(label, flush=True)
+
+def tap(page, name, role='button'):
+    page.get_by_role(role, name=name, exact=True).first.tap()
+
+def session(page, game, title):
+    page.goto(f'{BASE}/play/{game}')
+    page.get_by_role('navigation', name='Sessions').get_by_role('button', name=title).tap()
+
+def put(page, thing, where, placed=False):
+    tap(page, f'The {thing}' if placed else thing)
+    tap(page, where)
+
+def next_round(page):
+    tap(page, 'Next')
+    page.evaluate('() => scrollTo(0,0)')
+
+def scene(page):
+    session(page, 'scene', 'Not here')
+    record(page, 'scene-start')
+    put(page, 'key', 'Put the key in the box')
+    page.reload()
+    record(page, 'scene-1-reload')
+    tap(page, 'Is it true?')
+    record(page, 'scene-1-wrong')
+    tap(page, 'Change it')
+    tap(page, 'Hint')
+    put(page, 'key', 'Put the key on the book', True)
+    tap(page, 'Is it true?')
+    record(page, 'scene-1-right')
+    next_round(page)
+    put(page, 'ball', 'Front row, place 3 from the left')
+    tap(page, 'Is it true?')
+    record(page, 'scene-2-wrong')
+    tap(page, 'Change it')
+    tap(page, 'Hint')
+    put(page, 'ball', 'Back row, place 2 from the left', True)
+    tap(page, 'Is it true?')
+    record(page, 'scene-2-right')
+    next_round(page)
+    put(page, 'lamp', 'Front row, place 3 from the left')
+    tap(page, 'Is it true?')
+    record(page, 'scene-3-wrong')
+    tap(page, 'Change it')
+    tap(page, 'Hint')
+    put(page, 'lamp', 'Front row, place 1 from the left', True)
+    page.reload()
+    tap(page, 'Is it true?')
+    record(page, 'scene-3-right-reload')
+    next_round(page)
+    put(page, 'cup', 'Front row, place 1 from the left')
+    tap(page, 'Is it true?')
+    record(page, 'scene-4-wrong')
+    tap(page, 'Change it')
+    tap(page, 'Hint')
+    put(page, 'cup', 'Put the cup on the box', True)
+    tap(page, 'Is it true?')
+    record(page, 'scene-4-on-box-right')
+    next_round(page)
+    put(page, 'box', 'Front row, place 3 from the left')
+    put(page, 'key', 'Put the key in the box')
+    put(page, 'ball', 'Put the ball on the book')
+    page.reload()
+    tap(page, 'Is it true?')
+    record(page, 'scene-5-wrong-reload')
+    tap(page, 'Change it')
+    tap(page, 'Hint')
+    put(page, 'box', 'Front row, place 4 from the left', True)
+    tap(page, 'Is it true?')
+    record(page, 'scene-5-right')
+    next_round(page)
+    tap(page, 'Hint')
+    put(page, 'ball', 'Put the ball on the book')
+    tap(page, 'Is it true?')
+    record(page, 'scene-6-wrong')
+    tap(page, 'Change it')
+    record(page, 'scene-6-hint')
+    put(page, 'ball', 'Put the ball on the box', True)
+    tap(page, 'Is it true?')
+    record(page, 'scene-6-on-box-right')
+    next_round(page)
+    record(page, 'scene-done')
+
+def pupil(page):
+    session(page, 'pupil', 'Old rules, new words')
+    record(page, 'pupil-7-start')
+    for level, example in [(7, 'she stays'), (8, 'opening')]:
+        explanations = page.get_by_role('group', name='Explain the rule in words').get_by_role('button')
+        explanations.nth(0).tap()
+        record(page, f'pupil-{level}-explain-wrong')
+        tap(page, example)
+        page.reload()
+        record(page, f'pupil-{level}-example-reload')
+        explanations.nth(1).tap()
+        record(page, f'pupil-{level}-explain-right')
+        tap(page, "Now a word it hasn't seen")
+        page.reload()
+        record(page, f'pupil-{level}-twist-reload')
+        tap(page, 'Both are in use')
+        record(page, f'pupil-{level}-wrong-twist')
+        next_round(page)
+    record(page, 'pupil-done')
+    page.locator('summary').filter(has_text='What Wittgenstein said').tap()
+    record(page, 'pupil-source')
+
+def family(page):
+    session(page, 'family', 'What is a number?')
+    record(page, 'family-start')
+    for n, right in [(1, 'Most'), (2, 'Some')]:
+        tap(page, 'All', 'radio')
+        tap(page, 'Look')
+        record(page, f'family-{n}-all-wrong')
+        tap(page, 'Hint')
+        tap(page, right, 'radio')
+        page.reload()
+        expect(page.get_by_role('radio', name=right, exact=True)).to_be_checked()
+        record(page, f'family-{n}-choice-reload')
+        tap(page, 'Look')
+        record(page, f'family-{n}-right')
+        next_round(page)
+    tap(page, 'Hint')
+    tap(page, 'whole numbers')
+    tap(page, 'zero')
+    tap(page, 'can measure an amount')
+    record(page, 'family-zero-measure-rejected')
+    tap(page, 'can say how many')
+    page.reload()
+    record(page, 'family-thread-reload')
+    tap(page, '\u03c0 (pi)')
+    tap(page, 'can be written out in digits')
+    record(page, 'family-pi-digits-rejected')
+    tap(page, 'can be added together')
+    for name, feature in [('fractions', 'can measure an amount'), ('negative numbers', 'can measure an amount'), ('bus numbers', 'can be written out in digits')]:
+        tap(page, name)
+        tap(page, feature)
+    record(page, 'family-thread-done')
+    next_round(page)
+    record(page, 'family-newcomer-start')
+    page.get_by_label('Which one').select_option(label='whole numbers')
+    page.get_by_label('What they share').select_option(label='can name one thing among many')
+    tap(page, 'Say it')
+    record(page, 'family-whole-name-rejected')
+    page.get_by_label('Which one').select_option(label='bus numbers')
+    page.reload()
+    record(page, 'family-newcomer-reload')
+    tap(page, 'Say it')
+    record(page, 'family-newcomer-right')
+    next_round(page)
+    record(page, 'family-done')
+    page.locator('summary').filter(has_text='What Wittgenstein said').tap()
+    record(page, 'family-source')
+
+def main():
+    with sync_playwright() as p:
+        browser = p.chromium.launch()
+        ctx = browser.new_context(viewport={'width':390,'height':844}, device_scale_factor=1, is_mobile=True, has_touch=True)
+        page = ctx.new_page()
+        page.set_default_timeout(8000)
+        errors = []
+        page.on('pageerror', lambda e: errors.append(str(e)))
+        page.on('console', lambda m: errors.append(m.text) if m.type == 'error' else None)
+        {'scene': scene, 'pupil': pupil, 'family': family}[PHASE](page)
+        browser.close()
+        (OUT / f'phone-{PHASE}-errors.json').write_text(json.dumps(errors), encoding='utf-8')
+
+if __name__ == '__main__':
+    main()

