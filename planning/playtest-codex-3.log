+    tap(page, 'zero')
+    tap(page, 'can measure an amount')
+    record(page, 'family-zero-measure-rejected')
+    tap(page, 'can say how many')
+    page.reload()
+    record(page, 'family-thread-reload')
+    tap(page, '\u03c0 (pi)')
+    tap(page, 'can be written out in digits')
+    record(page, 'family-pi-digits-rejected')
+    tap(page, 'can be added together')
+    for name, feature in [('fractions', 'can measure an amount'), ('negative numbers', 'can measure an amount'), ('bus numbers', 'can be written out in digits')]:
+        tap(page, name)
+        tap(page, feature)
+    record(page, 'family-thread-done')
+    next_round(page)
+    record(page, 'family-newcomer-start')
+    page.get_by_label('Which one').select_option(label='whole numbers')
+    page.get_by_label('What they share').select_option(label='can name one thing among many')
+    tap(page, 'Say it')
+    record(page, 'family-whole-name-rejected')
+    page.get_by_label('Which one').select_option(label='bus numbers')
+    page.reload()
+    record(page, 'family-newcomer-reload')
+    tap(page, 'Say it')
+    record(page, 'family-newcomer-right')
+    next_round(page)
+    record(page, 'family-done')
+    page.locator('summary').filter(has_text='What Wittgenstein said').tap()
+    record(page, 'family-source')
+
+def main():
+    with sync_playwright() as p:
+        browser = p.chromium.launch()
+        ctx = browser.new_context(viewport={'width':390,'height':844}, device_scale_factor=1, is_mobile=True, has_touch=True)
+        page = ctx.new_page()
