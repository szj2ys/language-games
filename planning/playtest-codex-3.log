    page.get_by_role("button", name="Say it").click()
    expect(page.get_by_text("sits at the edge")).to_be_visible()
    shot(page, "family-edge")
    next_round(page)
    expect(page.get_by_role("heading", name=re.compile(r"Done.*What is a game\?"))).to_be_visible()


# --- Later sessions, reached through the session picker ----------------------------

def pick_session(page: Page, title: str) -> None:
    page.get_by_role("navigation", name="Sessions").get_by_role("button", name=title).click()


def play_later_sessions(page: Page) -> None:
    # Slab! "Order or report?": the fitting response in each situation.
    page.goto(f"{BASE}/play/builder")
    pick_session(page, "Order or report?")
    for answer in [
        "Bring him three slabs.",
        "Write “3 slabs” on the stock list.",
        "Answer: “No — it's a beam.”",
        "Jump out of the way.",
        "Ask: “Which one — the big one or the small one?”",
        "Write “2 beams” on the stock list.",
    ]:
        page.get_by_role("button", name=answer).click()
        expect(page.get_by_text("What the words were doing here")).to_be_visible()
        next_round(page)
    expect(page.get_by_role("heading", name=re.compile(r"Done.*Order or report"))).to_be_visible()
    expect(page.get_by_role("link", name="Next game: Picture Theatre")).to_be_visible()
    shot(page, "later-builder-end")

    # The Café, session 4: one wrong answer first, then the fitting ones.
    page.goto(f"{BASE}/play/cafe")
    pick_session(page, "Sorry, thanks, no problem")
    page.get_by_role("button", name="“You're welcome!”").click()
    expect(page.get_by_text("Not quite what Lena meant")).to_be_visible()
    for answer in [
        "“No problem — I'd nearly finished it anyway.”",
        "Say “Oh, sorry!” and move your bags.",
        "Keep holding the door and say “No problem!”",
        "Stop pouring.",
        "Smile and put the box away.",
        "Answer it: “Sorry — I'll be quick.”",
    ]:
        page.get_by_role("button", name=answer).click()
        expect(page.get_by_text("What the words were doing here")).to_be_visible()
        next_round(page)
    expect(page.get_by_role("heading", name=re.compile(r"Done.*Sorry, thanks"))).to_be_visible()
    shot(page, "later-cafe-end")

    # Family Threads, session 3: languages.
    page.goto(f"{BASE}/play/family")
    pick_session(page, "What is a language?")
    for q in ["Some", "Most"]:
        page.get_by_role("radio", name=q).click()
        page.get_by_role("button", name="Look").click()
        next_round(page)
    for name, link in [("English", None), ("sign language", "can give orders"), ("Morse code", "are used with the hands"),
                       ("road signs", "can give orders"), ("chemical formulas", "are used for one special job"),
                       ("music notation", "can be written down")]:
        page.get_by_role("button", name=name, exact=True).click()
        if link:
            page.get_by_role("button", name=link).click()
    expect(page.get_by_text("The thread holds")).to_be_visible()
    next_round(page)
    page.get_by_label("Which one").select_option(label="English")
    page.get_by_label("What they share").select_option(label="can be spoken aloud")
    page.get_by_role("button", name="Say it").click()
    expect(page.get_by_text("joins the family")).to_be_visible()
    next_round(page)
    expect(page.get_by_role("heading", name=re.compile(r"Done.*What is a language"))).to_be_visible()
    shot(page, "later-family-end")

    # Family Threads, session 4: kinds of number (§67).
    pick_session(page, "What is a number?")
    for q in ["Most", "Some"]:
        page.get_by_role("radio", name=q).click()
        page.get_by_role("button", name="Look").click()
        next_round(page)
    for name, link in [("whole numbers", None), ("fractions", "can measure an amount"), ("negative numbers", "can measure an amount"),
  tool("ruler", "the ruler", ["measure", "wood"]),
  tool("gluepot", "the glue-pot", ["handle", "join"]),
  tool("screwdriver", "the screwdriver", ["modify", "handle", "join", "metal"]),
  { ...tool("pliers", "the pliers", ["modify", "handle", "cut", "metal"]), plural: true },
];

const LANGUAGE_FEATURES: Feature[] = [
  { id: "spoken", plural: "can be spoken aloud", singular: "can be spoken aloud", colour: "#42649a" },
  { id: "written", plural: "can be written down", singular: "can be written down", colour: "#b0553e" },
  { id: "orders", plural: "can give orders", singular: "can give orders", colour: "#64775a" },
  { id: "stories", plural: "can tell a story", singular: "can tell a story", colour: "#c9a24a" },
  { id: "hands", plural: "are used with the hands", singular: "is used with the hands", colour: "#7a5c8a" },
  { id: "special", plural: "are used for one special job", singular: "is used for one special job", colour: "#5b5f60" },
];

const lang = (id: string, name: string, on: string[], blurred: string[] = []) => card(id, name, on, blurred, LANGUAGE_FEATURES);

// PI §18: "Our language can be seen as an ancient city … and this surrounded by a multitude of new
// boroughs" — the symbolism of chemistry, the notation of the calculus. Are these all languages?
const LANGUAGES: Card[] = [
  lang("english", "English", ["spoken", "written", "orders", "stories"]),
  lang("signlanguage", "sign language", ["orders", "stories", "hands"]),
  lang("roadsigns", "road signs", ["orders", "special"]),
  lang("chemistry", "chemical formulas", ["written", "special"]),
  lang("music", "music notation", ["written", "special"], ["stories"]),
  lang("morse", "Morse code", ["orders", "special", "hands", "written", "stories"], ["spoken"]),
];

const NUMBER_FEATURES: Feature[] = [
  { id: "howmany", plural: "can say how many", singular: "can say how many", colour: "#42649a" },
  { id: "measure", plural: "can measure an amount", singular: "can measure an amount", colour: "#b0553e" },
  { id: "order", plural: "can be put in order", singular: "can be put in order", colour: "#64775a" },
  { id: "add", plural: "can be added together", singular: "can be added together", colour: "#c9a24a" },
  { id: "name", plural: "can name one thing among many", singular: "can name one thing among many", colour: "#7a5c8a" },
  { id: "digits", plural: "can be written out in digits", singular: "can be written out in digits", colour: "#5b5f60" },
];

const num = (id: string, name: string, on: string[], blurred: string[] = []) => card(id, name, on, blurred, NUMBER_FEATURES);

// PI §67: "And for instance the kinds of number form a family in the same way." Why do we call something
// a number? Because it has a direct relationship with several things that have hitherto been called number.
const NUMBERS: Card[] = [
  num("wholenumbers", "whole numbers", ["howmany", "measure", "order", "add", "digits"]),
  num("fractions", "fractions", ["measure", "order", "add", "digits"]),
  num("negativenumbers", "negative numbers", ["measure", "order", "add", "digits"]),
  num("zero", "zero", ["howmany", "order", "add", "digits"]),
  num("busnumbers", "bus numbers", ["name", "digits"], ["order"]),
  num("pi", "π (pi)", ["measure", "order", "add"]),
];

export const SESSIONS: Session[] = [
  {
    id: "family-1",
    title: "What is a game?",
    blurb: "Look for what all these games have in common. Don't think — look!",
    forms: Object.fromEntries(Object.entries(plural.forms).map(([way, form]) => [way, she(form)])),
    correct: she(plural.correct),
  };
}

export type Verb = { word: string; stressedLast: boolean };

const CVC = /[^aeiou][aeiou][^aeiouwxy]$/;

export function pastItem(v: Verb): Item {
  const w = v.word;
  const plain = `${w}ed`;
  const dropE = w.endsWith("e") ? `${w}d` : plain;
  const doubleAny = CVC.test(w) ? `${w}${w.slice(-1)}ed` : dropE;
  const doubleStressed = CVC.test(w) && v.stressedLast ? `${w}${w.slice(-1)}ed` : dropE;
  return {
    word: w,
    forms: { ed: plain, "drop-e": dropE, "double-any": doubleAny, "double-stressed": doubleStressed },
    correct: doubleStressed,
  };
}

/** -ing spelling: the same choices as -ed (making, stopping, visiting). */
export function ingItem(v: Verb, irregular?: string): Item {
  const w = v.word;
  const plain = `${w}ing`;
  const dropE = w.endsWith("e") ? `${w.slice(0, -1)}ing` : plain;
  const doubleAny = CVC.test(w) ? `${w}${w.slice(-1)}ing` : dropE;
  const doubleStressed = CVC.test(w) && v.stressedLast ? `${w}${w.slice(-1)}ing` : dropE;
  return {
    word: w,
    forms: { ing: plain, "drop-e": dropE, "double-any": doubleAny, "double-stressed": doubleStressed },
    correct: irregular ?? doubleStressed,
  };
}

export type Adjective = { word: string; syllables: number };

export function comparativeItem(a: Adjective): Item {
  const w = a.word;
  const er = (x: string) => (x.endsWith("e") ? `${x}r` : `${x}er`);
  const short = CVC.test(w) ? `${w}${w.slice(-1)}er` : /y$/.test(w) ? `${w.slice(0, -1)}ier` : er(w);
  const always = er(w);
  const bySyllable = a.syllables === 1 ? short : `more ${w}`;
  const correct = a.syllables === 1 || (a.syllables === 2 && /y$/.test(w)) ? short : `more ${w}`;
  return { word: w, forms: { "always-er": always, syllables: bySyllable, "y-too": correct }, correct };
}

export type VerbPattern = { word: string; looksAhead: boolean };

/** "I enjoy swimming" / "I want to swim": the pupil's ways of going on after a verb. */
export function patternItem(v: VerbPattern, next = "swim", ing = "swimming"): Item {
  return {
    word: v.word,
    forms: {
      "always-to": `${v.word} to ${next}`,
      "always-ing": `${v.word} ${ing}`,
      "looks-ahead": v.looksAhead ? `${v.word} to ${next}` : `${v.word} ${ing}`,
    },
    correct: v.looksAhead ? `${v.word} to ${next}` : `${v.word} ${ing}`,
  };
}

export type Noun = { word: string; abstract: boolean; uncountable: boolean; plural?: string };

/** "two chairs" but "two pieces of furniture". */
export function countItem(n: Noun): Item {
  const counted = `two ${n.plural ?? `${n.word}s`}`;
  const pieces = `two pieces of ${n.word}`;
  return {
    word: n.word,
    forms: {
      "always-s": counted,
      abstract: n.abstract ? pieces : counted,
      listed: n.uncountable ? pieces : counted,
    },
    correct: n.uncountable ? pieces : counted,
  };
}

