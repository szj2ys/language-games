  "next to": "next to",
  behind: "behind",
  "in front of": "in front of",
  in: "in",
  on: "on",
};

/** Where a thing sits on the shelf, following holders down to the ground. */
function ground(scene: Scene, t: Thing, seen = new Set<Thing>()): { spot: number; row: "front" | "back" } | null {
