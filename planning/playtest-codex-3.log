+        record(page, f'pupil-{level}-wrong-twist')
+        next_round(page)
+    record(page, 'pupil-done')
+    page.locator('summary').filter(has_text='What Wittgenstein said').tap()
+    record(page, 'pupil-source')
+
+def family(page):
+    session(page, 'family', 'What is a number?')
+    record(page, 'family-start')
+    for n, right in [(1, 'Most'), (2, 'Some')]:
