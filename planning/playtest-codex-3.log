        shot(page, f"builder-there-{i}")
        advance(page, call)
    page.get_by_role("button", name="Next: Your turn to call").click()

    # Session 3: the player calls. Round 1: "Pillar!"
    def say(*tiles: str) -> None:
        bank = page.get_by_role("group", name="Words you can use")
