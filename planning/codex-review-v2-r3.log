    <>
      <SiteHeader />
      <main id="main" className="mx-auto w-full max-w-3xl px-4 py-8">
        <h1 className="font-heading text-[40px] leading-tight font-medium">Your notebook</h1>
        <Notebook />
      </main>
    </>
  );
}

