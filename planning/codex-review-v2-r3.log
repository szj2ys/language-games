+    page.screenshot(path=str(OUT / (name + '.png')))
+    return {'name': name, 'url': page.url, 'body': page.locator('body').inner_text()}
+
+with sync_playwright() as pw:
+    browser = pw.chromium.launch()
+    for device, vp, touch in [('phone', {'width':390,'height':844}, True), ('desktop', {'width':1440,'height':900}, False)]:
+        ctx = browser.new_context(viewport=vp, is_mobile=touch, has_touch=touch)
+        page = ctx.new_page()
+        page.add_init_script("""window.reviewPerf={lcp:0,cls:0};new PerformanceObserver(l=>{for(const e of l.getEntries())window.reviewPerf.lcp=e.startTime}).observe({type:'largest-contentful-paint',buffered:true});new PerformanceObserver(l=>{for(const e of l.getEntries())if(!e.hadRecentInput)window.reviewPerf.cls+=e.value}).observe({type:'layout-shift',buffered:true});""")
+        page.goto(BASE, wait_until='networkidle')
+        records.append({'device':device, 'test':'performance-local', **page.evaluate('()=>({...window.reviewPerf,resources:performance.getEntriesByType("resource").reduce((a,e)=>(a[e.initiatorType]=(a[e.initiatorType]||0)+e.transferSize,a),{})})')})
+        # True touch operation and persistence of the keyboard preference.
+        page.goto(BASE+'/notebook', wait_until='networkidle')
+        check=page.get_by_role('checkbox')
+        before=check.is_checked()
+        label=page.locator('label').filter(has=check)
+        label.tap() if touch else label.click()
+        toggled=check.is_checked()
+        page.reload(wait_until='networkidle')
+        records.append({'device':device,'test':'shortcut-label-toggle','before':before,'after':toggled,'afterReload':page.get_by_role('checkbox').is_checked()})
+        page.goto(BASE+'/play/builder',wait_until='networkidle')
+        page.keyboard.press('3')
+        page.wait_for_timeout(300)
+        records.append({'device':device,'test':'shortcut-disabled',**save(page,device+'-shortcut-disabled')})
+        slab=page.get_by_role('button',name='slab',exact=True)
+        slab.tap() if touch else slab.click()
+        page.wait_for_timeout(1600)
+        page.goto(BASE+'/notebook',wait_until='networkidle')
+        records.append({'device':device,'test':'touch-play-saved',**save(page,device+'-touch-notebook')})
+        page.get_by_role('link',name='Play again',exact=True).first.click()
+        page.wait_for_timeout(250)
+        records.append({'device':device,'test':'notebook-replay',**save(page,device+'-notebook-replay')})
+        # Keyboard skip link must become visible and land in main content.
+        page.goto(BASE,wait_until='networkidle')
+        page.keyboard.press('Tab')
+        focused=page.locator(':focus').evaluate('(e)=>({tag:e.tagName,text:e.innerText,rect:e.getBoundingClientRect().toJSON()})')
+        page.keyboard.press('Enter')
+        records.append({'device':device,'test':'skip-link','focused':focused,'urlAfter':page.url})
+        ctx.close()
+    # Storage denial: content should remain playable and report that progress is temporary.
+    for scenario, init in [('denied',"Object.defineProperty(window,'localStorage',{get(){throw new DOMException('Review denied','SecurityError')}})"),('corrupt',"localStorage.setItem('language-games:v1','{broken')")]:
+        ctx=browser.new_context(viewport={'width':390,'height':844},is_mobile=True,has_touch=True)
+        ctx.add_init_script(init)
+        page=ctx.new_page(); errors=[]
+        page.on('pageerror',lambda e:errors.append(str(e)))
+        page.goto(BASE+'/play/builder',wait_until='networkidle')
+        page.get_by_role('button',name='slab',exact=True).tap()
+        page.wait_for_timeout(1600)
+        records.append({'test':'storage-'+scenario,'errors':errors,**save(page,'phone-storage-'+scenario)})
+        ctx.close()
+    # Slow first arrival and offline recovery are diagnostics, not requirements invented for the site.
+    ctx=browser.new_context(viewport={'width':390,'height':844},is_mobile=True,has_touch=True)
+    page=ctx.new_page(); cdp=ctx.new_cdp_session(page)
+    cdp.send('Network.enable')
+    cdp.send('Network.emulateNetworkConditions',{'offline':False,'latency':400,'downloadThroughput':50000,'uploadThroughput':50000})
+    page.goto(BASE,wait_until='commit')
+    page.wait_for_timeout(2500)
+    records.append({'test':'slow-home-2500ms',**save(page,'phone-slow-home-2500ms')})
+    page.wait_for_timeout(6500)
+    records.append({'test':'slow-home-9000ms',**save(page,'phone-slow-home-9000ms')})
+    cdp.send('Network.emulateNetworkConditions',{'offline':False,'latency':0,'downloadThroughput':-1,'uploadThroughput':-1})
+    page.goto(BASE+'/play/builder',wait_until='networkidle')
+    ctx.set_offline(True)
+    page.get_by_role('button',name='slab',exact=True).tap()
+    page.wait_for_timeout(1600)
+    records.append({'test':'already-loaded-offline-play',**save(page,'phone-offline-loaded-play')})
+    try:
+        page.reload(wait_until='domcontentloaded',timeout=5000)
