"use client";

import Link from "next/link";
import { ArrowRight } from "lucide-react";
import { buttonVariants } from "@/components/ui/button";
import { GAMES } from "@/content/games";
import { SOURCES } from "@/content/sources";
import { useSave } from "@/lib/use-save";
import { cn } from "@/lib/utils";

/** Continue where you left off; a first visit starts at the first idea. */
export function ContinueButton() {
  const { save, ready } = useSave();
  const last = ready ? GAMES.find((g) => g.slug === save.lastGame) : undefined;
  const target = last ?? GAMES[0];
  return (
    <Link href={`/play/${target.slug}`} className={cn(buttonVariants({ size: "lg" }), "h-13 px-6 text-lg")}>
      {last ? `Continue: ${last.step}. ${last.title}` : "Start with the first idea"} <ArrowRight className="size-5" aria-hidden />
    </Link>
  );
}

export function GameProgress({ rounds }: { rounds: string[] }) {
  const { save, ready } = useSave();
  if (!ready) return null;
  const done = rounds.filter((id) => save.rounds[id]).length;
  if (done === 0) return null;
  return (
    <span className="shrink-0 rounded-full bg-sage/15 px-2 py-0.5 text-[13px] font-bold text-sage">
      {done === rounds.length ? "Done" : `${done}/${rounds.length}`}
    </span>
  );
}

/** When every round is done: no streak, no "come back tomorrow" — the ladder can be thrown away. */
export function LadderEnd() {
  const { save, ready } = useSave();
  if (!ready) return null;
  const all = GAMES.flatMap((g) => g.rounds);
  if (!all.every((id) => save.rounds[id])) return null;
  const ladder = SOURCES["tlp-6.54"];
  const stop = SOURCES["pi-133"];
  return (
    <section className="mt-8 rounded-lg border border-border bg-card p-5" aria-labelledby="ladder">
      <h2 id="ladder" className="font-heading text-2xl font-semibold">
        You have walked the whole path.
      </h2>
      <p className="mt-2 text-[17px] leading-relaxed">
        That is the end — there is no streak to keep. In the Tractatus Wittgenstein says of his own book: “{ladder.quote}” ({ladder.ref}).
        Later he put it differently: “{stop.quote}” (PI {stop.ref}). Now read him: the passages are all on the sources page.
      </p>
    </section>
  );
}
# Early games live review, round 3

Served production URL: http://localhost:3417. Python Playwright Chromium, headless, 390×844 mobile/touch and 1440×900 desktop. No server lifecycle actions; no writes under src/, public/, e2e/ or art/. Python bytecode generation was disabled before importing the existing journey helper.

## Earlier finding recheck

- **R2-2: fixed for this review's scope.** Home now has the compact portrait cutout and illustrated seven-stop path; builder has one row of four readable touch choices, a restrained scene and an adjacent idea card visible in the phone viewport. Initial screenshots: `phone/001-prior-initial-home.png`, `phone/003-prior-initial-builder.png`, `desktop/144-prior-initial-home.png`, `desktop/146-prior-initial-builder.png`. The internal game scenes retain painted rectangular illustrations rather than reproducing every paper edge from the mock-up, but the earlier actionable composition failures no longer justify the old major finding. Parent reviewer handles the remaining game/page coverage for this finding.
- **R2-4: fixed.** `/play/builder`, `b2-1`, hint now explains the role of a number word in the building practice; the plural suffix lesson is absent. Evidence: `edges/phone-builder-b2-1-hint.png` and desktop equivalent.
- **R2-6: fixed.** `/play/cafe`, `c1-1`, deliberately selecting the November remark leaves the complete correction visible on phone at y=780.5–841.5 in an 844px viewport; desktop y=570.75–640.75. Evidence: `edges/edges.json`, `edges/phone-cafe-wrong.png`, desktop equivalent.

## New finding

**Minor — Family resemblance rejects the claim that sign language can be written.**

Where: http://localhost:3417/play/family, Sessions → What is a language?, `f3-3`; `src/games/family/rounds.ts:88`. Evidence: `edges/phone-signlanguage-written.png`, `edges/desktop-signlanguage-written.png`, `edges/sign-probe.json`.

After completing the first two rounds, select English, sign language, then “can be written down”. The game explicitly rejects the link: “It isn't true that both English and sign language can be written down. Try another link.” This is an authored categorical judgment, not a broken button. Standard sign-language writing/notation systems make the categorical denial over-broad; the philosophy reviewer supplies the primary reference. Concrete fix: accept written sign languages, or mark the feature as qualified/blurred and describe the specific practice pictured; do not penalize a valid comparison.

## Completed evidence

- `python -B qa/codex-review-r3/early-games/review.py` completed all 16 sessions on both devices: builder 24/24, scene 24/24, cafe 24/24, family 19/19; **91/91 rounds per device**. `coverage.json` lists every authored round ID and has no missing IDs. Genuine post-play saves are `phone/storage.json` and `desktop/storage.json`.
- Later sessions were selected using Sessions. Wrong answers were operated in every game. Builder quantity/location work survived a mid-round reload in the main journey. `edges.py` additionally exercised wrong-answer reloads in builder, café and family and a scene placement draft reload on both devices. Café/family/scene before/after body text matched; the saved scene draft submitted correctly after reload.
