import json, pathlib, urllib.request
import fitz

out = pathlib.Path(__file__).resolve().parent
urls = {
 'pi': 'https://static1.squarespace.com/static/54889e73e4b0a2c1f9891289/t/564b61a4e4b04eca59c4d232/1447780772744/Ludwig.Wittgenstein.-.Philosophical.Investigations.pdf',
 'oc': 'https://www.circuitdebater.org/circuitdebater/archive/w/file/view/On%20Certainty.pdf/507953768/On%20Certainty.pdf',
 'tlp': 'https://www.wittgensteinproject.org/w/index.php/Tractatus_Logico-Philosophicus_(English)',
}
results = {}
for key, url in urls.items():
 try:
  raw = urllib.request.urlopen(urllib.request.Request(url, headers={'User-Agent': 'Mozilla/5.0'}), timeout=30).read()
  if raw[:4] == b'%PDF':
   doc = fitz.open(stream=raw, filetype='pdf')
   text = '\n'.join(f'\n[PDF page {i+1}]\n' + page.get_text() for i, page in enumerate(doc))
   (out / f'{key}-primary.pdf').write_bytes(raw)
  else:
   from bs4 import BeautifulSoup
   text = BeautifulSoup(raw, 'html.parser').get_text(' ', strip=True)
  (out / f'{key}-primary.txt').write_text(text, encoding='utf-8')
  results[key] = {'url': url, 'bytes': len(raw), 'text_chars': len(text), 'success': True}
 except Exception as e:
  results[key] = {'url': url, 'success': False, 'error': str(e)}
(out / 'primary-fetch.json').write_text(json.dumps(results, indent=2),encoding='utf-8')
print(json.dumps(results, indent=2))
const fs = require('fs');
const path = require('path');
const ts = require('typescript');
const Module = require('module');
const root = path.resolve(__dirname, '../../..');
const original = Module._resolveFilename;
Module._resolveFilename = function (request, ...args) {
  return original.call(this, request.startsWith('@/') ? path.join(root, 'src', request.slice(2)) : request, ...args);
};
require.extensions['.ts'] = function (module, filename) {
  const code = ts.transpileModule(fs.readFileSync(filename, 'utf8'), { compilerOptions: { module: ts.ModuleKind.CommonJS, target: ts.ScriptTarget.ES2022 } }).outputText;
  module._compile(code, filename);
};
const sources = require(path.join(root, 'src/content/sources.ts')).SOURCES;
const games = {};
for (const game of ['scene','builder','cafe','family','pupil','beetle','hinges']) {
  const file = path.join(root, 'src/games', game, game === 'pupil' ? 'levels.ts' : 'rounds.ts');
  const module = require(file);
  games[game] = {file: path.relative(root,file).replaceAll('\\','/'), sessions: module.SESSIONS};
}
fs.writeFileSync(path.join(__dirname, 'current-content.json'), JSON.stringify({sources,games},null,2));
console.log(JSON.stringify({sources:Object.keys(sources).length, games:Object.fromEntries(Object.entries(games).map(([k,v])=>[k,{sessions:v.sessions.length,rounds:v.sessions.reduce((n,s)=>n+s.rounds.length,0)}]))}));

