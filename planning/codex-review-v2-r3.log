import json,re
from pathlib import Path
from playwright.sync_api import sync_playwright
ROOT=Path(__file__).resolve().parents[2]
OUT=Path(__file__).resolve().parent/'root'
BASE='http://localhost:3417'
log=[]

def save(page,name):
    page.screenshot(path=str(OUT/(name+'.png')),full_page=True)
    entry={'name':name,'url':page.url,'body':page.locator('body').inner_text(),'storage':page.evaluate('()=>({...localStorage})')}
    log.append(entry)
    (OUT/'edges.json').write_text(json.dumps(log,indent=2),encoding='utf8')
    return entry

def scan(page,name):
    page.add_script_tag(path=str(ROOT/'node_modules/axe-core/axe.min.js'))
    log.append({'name':name,'axe':page.evaluate("async()=> (await axe.run(document,{resultTypes:['violations']})).violations")})

with sync_playwright() as pw:
    b=pw.chromium.launch()
    for device,vp,touch in [('phone',{'width':390,'height':844},True),('desktop',{'width':1440,'height':900},False)]:
        c=b.new_context(viewport=vp,is_mobile=touch,has_touch=touch)
        a=c.new_page()
        a.goto(BASE+'/play/builder',wait_until='networkidle')
        a.get_by_role('button',name='slab',exact=True).click()
        a.wait_for_timeout(1600)
        a.goto(BASE+'/notebook',wait_until='networkidle')
        save(a,device+'-notebook-completed')
        scan(a,device+'-notebook-axe')
        a.locator('summary').filter(has_text='Your answers').first.click()
        save(a,device+'-notebook-expanded')
        a.get_by_role('link',name=re.compile('Read Philosophical')).first.click()
        a.wait_for_url('**/sources#pi-2')
        a.wait_for_timeout(400)
        log.append({'name':device+'-notebook-source','url':a.url,'target':a.evaluate("()=>document.getElementById(location.hash.slice(1))?.getBoundingClientRect().toJSON()")})
        save(a,device+'-source-hash')
        a.goto(BASE+'/notebook',wait_until='networkidle')
        second=c.new_page()
        second.goto(BASE+'/notebook',wait_until='networkidle')
        third=c.new_page()
        third.goto(BASE+'/play/builder',wait_until='networkidle')
        third.get_by_role('navigation',name='Sessions').get_by_role('button',name=re.compile('Two slabs')).click()
        third.get_by_role('button',name='slab',exact=True).click()
        third.get_by_role('button',name='One more',exact=True).click()
        save(third,device+'-active-before-reset')
        a.get_by_role('button',name='Reset progress',exact=True).click()
        a.get_by_role('button',name='Yes, start over',exact=True).click()
        second.wait_for_timeout(300)
        save(a,device+'-reset-tab-a')
        save(second,device+'-reset-tab-b')
        save(third,device+'-reset-active-game')
        if second.get_by_role('link',name='Play again',exact=True).count():
            second.get_by_role('link',name='Play again',exact=True).first.click()
        a.reload(wait_until='networkidle')
        save(a,device+'-reset-after-reload')
        third.reload(wait_until='networkidle')
        save(third,device+'-reset-game-reloaded')
        c.close()
    b.close()
(OUT/'edges.json').write_text(json.dumps(log,indent=2),encoding='utf8')
print(json.dumps([{'name':x['name'],'url':x.get('url'),'empty':'Nothing here yet.' in x.get('body',''),'axe':[v['id'] for v in x.get('axe',[])]} for x in log]))

