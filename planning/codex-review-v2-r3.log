+import sys
+sys.dont_write_bytecode = True
+import json, re
+from pathlib import Path
+from playwright.sync_api import sync_playwright
+from PIL import Image, ImageOps, ImageDraw
+
+ROOT = Path(__file__).resolve().parents[2]
+OUT = Path(__file__).resolve().parent / 'root'
+BASE = 'http://localhost:3417'
+records = []
+
+def save(page, name):
+    page.screenshot(path=str(OUT / (name + '.png')))
+    return {'name': name, 'url': page.url, 'body': page.locator('body').inner_text()}
+
+with sync_playwright() as pw:
+    browser = pw.chromium.launch()
+    for device, vp, touch in [('phone', {'width':390,'height':844}, True), ('desktop', {'width':1440,'height':900}, False)]:
+        ctx = browser.new_context(viewport=vp, is_mobile=touch, has_touch=touch)
+        page = ctx.new_page()
