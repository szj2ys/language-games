603:   "citations": [{ "sourceId": "PI-185", "role": "enacted" }, { "sourceId": "PI-198", "role": "context" }],
604:   "debrief": "Every card also fitted a wrong way of going on, as in §185. Training on cases, not a formula, got the pupil into the practice.",
605:   "par": 2, "solution": ["egg", "unicorn"], "status": "reviewed",
606:   "payload": {
