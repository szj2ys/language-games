608:     "ways": [
609:       { "id": "always-a", "label": "always 'a'", "rank": 1 },
610:       { "id": "letter", "label": "'an' before a vowel letter", "rank": 2 },
611:       { "id": "sound", "label": "'an' before a vowel sound", "rank": 3, "correct": true }
612:     ],
613:     "items": [
614:       { "id": "egg", "prompt": "egg", "out": { "always-a": "a", "letter": "an", "sound": "an" }, "why": "'egg' starts with a vowel sound." },
615:       { "id": "unicorn", "prompt": "unicorn", "out": { "always-a": "a", "letter": "an", "sound": "a" }, "why": "'unicorn' starts with a 'you' sound, which is a consonant sound." },
616:       { "id": "hour", "prompt": "hour", "out": { "always-a": "a", "letter": "a", "sound": "an" }, "why": "The h is silent, so 'hour' starts with a vowel sound." }
617:     ],
618:     "deck": ["egg", "umbrella", "unicorn", "hotel", "cat"],
619:     "exam": ["hour", "university", "apple", "mba", "horse"],
620:     "explain": { "text": "Use 'an' before a vowel.", "keeps": ["letter", "sound"] },
621:     "twist": { "prompt": "URL", "accepted": ["a", "an"], "call": "both-in-use",
622:                "why": "Most people say 'you-are-el', so 'a URL'; some say 'earl' and write 'an URL'." }
623:   }
624: }
625: ```
626: 
627: The `items` list above is shortened; a real round lists every deck and exam item.
