563:   "citations": [{ "sourceId": "PI-8", "role": "enacted" }, { "sourceId": "PI-2", "role": "context" }],
564:   "debrief": "You extended the builders' language as §8 does: a number, 'there', and a pointing hand.",
565:   "par": 2,
566:   "solution": ["put two red pillars there@1,0;3,0", "put the grey beam on the pillars"],
567:   "art": { "stage": "slab-site" },
