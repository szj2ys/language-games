    let ok: boolean;
    let why: string;
    if (mode === "both") {
      ok = n.features[f.id] === true && o.features[f.id] === true;
      const lacking = n.features[f.id] === true ? o : n;
      why = ok
        ? `True — ${n.name} ${agree(n, "joins", "join")} the family through ${o.name}.`
