from pathlib import Path
from playwright.sync_api import sync_playwright,expect
OUT=Path(__file__).resolve().parent
ROOT=OUT.parents[2]
records=[]
with sync_playwright() as p:
    browser=p.chromium.launch()
    for device in ['phone','desktop']:
        folder=OUT/(device+'-migration');folder.mkdir(exist_ok=True)
        ctx=browser.new_context(viewport={'width':390,'height':844} if device=='phone' else {'width':1440,'height':900},is_mobile=device=='phone',has_touch=device=='phone',storage_state=str(ROOT/'qa/codex-review-r3/late-games'/device/'storage.json'))
        page=ctx.new_page()
        def snap(name):
            page.screenshot(path=str(folder/(name+'.png')),full_page=True)
            records.append({'device':device,'name':name,'text':page.locator('body').inner_text(),'storage':page.evaluate('()=>({...localStorage})')})
        page.goto('http://localhost:3417/play/hinges',wait_until='networkidle');snap('returning-entry')
        page.get_by_role('navigation',name='Sessions').get_by_role('button',name=re.compile('Doubt it')).click();snap('returning-doubt-it')
        page.goto('http://localhost:3417/notebook',wait_until='networkidle')
        for el in page.locator('summary').all():
            if 'Your answers' in el.inner_text():el.click()
        snap('returning-notebook')
        page.reload();snap('returning-notebook-after-reload')
        ctx.close()
    browser.close()
(OUT/'migration.json').write_text(json.dumps(records,indent=2),encoding='utf8')
